"content-type": "text/html", "content-version": "vor", "intended-application": "text-mining"}], "deposited": {"date-parts": [[2026, 8, 11]], "date-time": "2026-08-11T13:55:53Z", "timestamp": 1786456553000}, "score": 27.562431, "resource": {"primary": {"URL": "https://www.nature.com/articles/s41598-026-66422-3"}}, "issued": {"date-parts": [[2026, 8, 11]]}, "references-count": 0, "alternative-id": ["66422"], "URL": "https://doi.org/10.1038/s41598-026-66422-3", "ISSN": ["2045-2322"], "issn-type": [{"value": "2045-2322", "type": "electronic"}], "published": {"date-parts": [[2026, 8, 11]]}, "assertion": [{"value": "23 July 2025", "order": 1, "name": "received", "label": "Received", "group": {"name": "ArticleHistory", "label": "Article History"}}, {"value": "7 August 2026", "order": 2, "name": "accepted", "label": "Accepted", "group": {"name": "ArticleHistory", "label": "Article History"}}, {"value": "11 August 2026", "order": 3, "name": "first_online", "label": "First Online", "group": {"name": "ArticleHistory", "label": "Article History"}}]}, {"indexed": {"date-parts": [[2026, 2, 26]], "date-time": "2026-02-26T19:20:52Z", "timestamp": 1772133652594, "version": "3.50.1"}, "description": "Supplemental Information for 10.1021/jacs.6b03520", "reference-count": 0, "publisher": "American Chemical Society (ACS)", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.1021/jacs.6b03520.s001", "type": "component", "created": {"date-parts": [[2020, 4, 8]], "date-time": "2020-04-08T06:45:40Z", "timestamp": 1586328340000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Enhancing Perovskite Electrocatalysis through Strain Tuning of the Oxygen Deficiency"], "prefix": "10.1021", "member": "316", "deposited": {"date-parts": [[2020, 4, 8]], "date-time": "2020-04-08T06:45:40Z", "timestamp": 1586328340000}, "score": 25.360945, "resource": {"primary": {"URL": "https://pubs.acs.org/doi/suppl/10.1021/jacs.6b03520/suppl_file/ja6b03520_si_001.pdf"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.1021/jacs.6b03520.s001", "relation": {"is-component-of": [{"id-type": "doi", "id": "10.1021/jacs.6b03520", "asserted-by": "object"}]}}, {"indexed": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T16:02:22Z", "timestamp": 1781280142223, "version": "3.54.1"}, "posted": {"date-parts": [[2025, 2, 26]]}, "reference-count": 0, "publisher": "Institute of Electrical and Electronics Engineers (IEEE)", "license": [{"start": {"date-parts": [[2025, 2, 26]], "date-time": "2025-02-26T00:00:00Z", "timestamp": 1740528000000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by-nc-sa/4.0/"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Black-box attacks play a crucial role in identifying vulnerabilities in deep neural networks by generating adversarial examples that remain imperceptible to human observers. Transfer-based attacks, which leverage surrogate models to craft adversarial examples for attacking victim models, have become a dominant technique in black-box settings due to their practicality and high effectiveness.\u00a0However, as deep learning models continue to grow in complexity, the resulting disparities between different architectures make generating adversarial examples with strong transferability increasingly difficult.\u00a0To address this challenge, we propose a novel hybrid query-transfer method called Dual Generalization Attack (DGA).\u00a0Specifically, DGA enhances model generalization by incorporating a Model Filter (MF) that injects posterior information from the victim model through a limited number of queries, thereby reducing the gap between the surrogate and victim models.\u00a0Additionally, DGA introduces a Multi-granularity Local Shuffle (MLS) technique to improve input generalization, enhancing input diversity while preserving consistency with the original images.\u00a0This dual approach reduces the dependency of adversarial examples on both surrogate models and input configurations, thereby enhancing transferability and attack performance on unknown victim models.\u00a0Extensive experiments demonstrate that DGA significantly outperforms existing black-box attacks, achieving a substantial improvement in adversarial transferability.</jats:p>", "DOI": "10.36227/techrxiv.174058890.00970765/v1", "type": "posted-content", "created": {"date-parts": [[2025, 2, 26]], "date-time": "2025-02-26T11:55:07Z", "timestamp": 1740570907000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Dual Generalization Attack: Enhancing Adversarial Transferability through Surrogate Model and Input Feature Generalization"], "prefix": "10.36227", "author": [{"given": "Kun", "family": "He", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Zhenhua", "family": "Chen", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Xin", "family": "Liu", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"ORCID": "https://orcid.org/0000-0002-5070-348X", "authenticated-orcid": false, "given": "Xinze", "family": "Zhang", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "263", "link": [{"URL": "https://www.techrxiv.org/doi/pdf/10.36227/techrxiv.174058890.00970765/v1", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T15:11:47Z", "timestamp": 1781277107000}, "score": 25.331219, "resource": {"primary": {"URL": "https://www.techrxiv.org/doi/full/10.36227/techrxiv.174058890.00970765/v1"}}, "issued": {"date-parts": [[2025, 2, 26]]}, "references-count": 0, "URL": "https://doi.org/10.36227/techrxiv.174058890.00970765/v1", "