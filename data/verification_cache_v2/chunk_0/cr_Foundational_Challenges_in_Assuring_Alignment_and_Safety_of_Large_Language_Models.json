, "issue": "2", "license": [{"start": {"date-parts": [[2025, 6, 17]], "date-time": "2025-06-17T00:00:00Z", "timestamp": 1750118400000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by-nd/4.0"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["SI"], "abstract": "<jats:p>Brief descriptions of the contents of this issue.</jats:p>", "DOI": "10.70777/si.v2i2.14909", "type": "journal-article", "created": {"date-parts": [[2025, 6, 18]], "date-time": "2025-06-18T03:34:12Z", "timestamp": 1750217652000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Highlights of the Issue"], "prefix": "10.70777", "volume": "2", "author": [{"ORCID": "https://orcid.org/0000-0003-2101-3567", "authenticated-orcid": false, "given": "Kristen", "family": "Carlson", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "51608", "published-online": {"date-parts": [[2025, 6, 17]]}, "container-title": ["SuperIntelligence - Robotics - Safety &amp; Alignment"], "link": [{"URL": "https://s-rsa.com/index.php/agi/article/download/14909/11017", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://s-rsa.com/index.php/agi/article/download/14909/11017", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2025, 6, 19]], "date-time": "2025-06-19T03:34:20Z", "timestamp": 1750304060000}, "score": 33.127354, "resource": {"primary": {"URL": "https://s-rsa.com/index.php/agi/article/view/14909"}}, "subtitle": ["Large Language Models II"], "issued": {"date-parts": [[2025, 6, 17]]}, "references-count": 0, "journal-issue": {"issue": "2", "published-online": {"date-parts": [[2025, 5, 29]]}}, "URL": "https://doi.org/10.70777/si.v2i2.14909", "ISSN": ["3067-2627"], "issn-type": [{"value": "3067-2627", "type": "electronic"}], "published": {"date-parts": [[2025, 6, 17]]}}, {"indexed": {"date-parts": [[2026, 7, 9]], "date-time": "2026-07-09T15:14:06Z", "timestamp": 1783610046183, "version": "3.55.0"}, "reference-count": 0, "publisher": "Carlson Research LLC", "issue": "2", "license": [{"start": {"date-parts": [[2025, 5, 30]], "date-time": "2025-05-30T00:00:00Z", "timestamp": 1748563200000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by-nd/4.0"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["SI"], "abstract": "<jats:p>We evaluated 4 systems (ELIZA, GPT-4o, LLaMa-3.1-405B, and GPT-4.5) in two randomised, controlled, and pre-registered Turing tests on independent populations. Participants had 5 minute conversations simultaneously with another human participant and one of these systems before judging which conversational partner they thought was human. When prompted to adopt a humanlike persona, GPT-4.5 was judged to be the human 73% of the time: significantly more often than interrogators selected the real human participant. LLaMa-3.1, with the same prompt, was judged to be the human 56% of the time\u2014not significantly more or less often than the humans they were being compared to\u2014while baseline models (ELIZA and GPT-4o) achieved win rates significantly below chance (23% and 21% respectively). The results constitute the first empirical evidence that any artificial system passes a standard three-party Turing test. The results have implications for debates about what kind of intelligence is exhibited by Large Language Models (LLMs), and the social and economic impacts these systems are likely to have.</jats:p>", "DOI": "10.70777/si.v2i2.14697", "type": "journal-article", "created": {"date-parts": [[2025, 5, 31]], "date-time": "2025-05-31T03:33:00Z", "timestamp": 1748662380000}, "source": "Crossref", "is-referenced-by-count": 9, "title": ["Review: Large Language Models Pass the Turing Test"], "prefix": "10.70777", "volume": "2", "author": [{"ORCID": "https://orcid.org/0000-0003-2101-3567", "authenticated-orcid": false, "given": "Kristen W", "family": "Carlson", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "51608", "published-online": {"date-parts": [[2025, 5, 30]]}, "container-title": ["SuperIntelligence - Robotics - Safety &amp; Alignment"], "link": [{"URL": "https://s-rsa.com/index.php/agi/article/download/14697/10913", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://s-rsa.com/index.php/agi/article/download/14697/10913", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2025, 5, 31]], "date-time": "2025-05-31T03:33:02Z", "timestamp": 1748662382000}, "score": 32.638016, "resource": {"primary": {"URL": "https://s-rsa.com/index.php/agi/article/view/14697"}}, "issued": {"date-parts": [[2025, 5, 30]]}, "references-count": 0, "journal-issue": {"issue": "2", "published-online": {"date-parts": [[2025, 5, 29]]}}, "URL": "https://doi.org/10.70777/si.v2i2.14697", "ISSN": ["3067-2627"], "issn-type": [{"value": "3067-2627", "type": "electronic"}], "published": {"date-parts": [[2025, 5, 30]]}}, {"indexed": {"date-parts": [[2026, 8, 8]], "date-time": "2026-08-08T06:45:13Z", "timestamp": 1786171513241, "version": "build-2736575974"}, "reference-count": 12, "publisher": "IEEE", "license": [{"start": {"date-parts": [[2026, 6, 1]], "date-time": "2026-06-01T00:00:00Z", "timestamp": 1780272000000}, "content-version": "vor", "delay-in-days": 0, "URL": "https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html"}, {"start": {"date-parts": [[2026, 6, 1]], "date-time": "2026-06-01T00:00:00Z", "timestamp": 1780272000000}, "content-version": "stm-asf", "delay-in-days": 0, "URL": "https://doi.org/10.15223/policy-029"}, {"star