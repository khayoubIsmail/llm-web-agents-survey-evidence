al-issue": {"issue": "4", "published-online": {"date-parts": [[2025, 4, 28]]}, "published-print": {"date-parts": [[2025, 4, 28]]}}, "URL": "https://doi.org/10.21275/sr25424081718", "ISSN": ["2319-7064"], "issn-type": [{"value": "2319-7064", "type": "electronic"}], "published": {"date-parts": [[2025, 4, 28]]}}, {"indexed": {"date-parts": [[2024, 5, 2]], "date-time": "2024-05-02T09:41:27Z", "timestamp": 1714642887656}, "publisher-location": "Basingstoke", "reference-count": 0, "publisher": "Palgrave Macmillan", "isbn-type": [{"value": "9781137292094", "type": "print"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.1057/9781137292094.0015", "type": "book-chapter", "created": {"date-parts": [[2013, 8, 16]], "date-time": "2013-08-16T09:52:45Z", "timestamp": 1376646765000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Reflective Nostalgia and Diasporic Memory"], "prefix": "10.1057", "author": [{"given": "Elaine", "family": "Kelly", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "297", "container-title": ["Remembering and Rethinking the GDR"], "language": "en", "deposited": {"date-parts": [[2015, 10, 9]], "date-time": "2015-10-09T13:06:23Z", "timestamp": 1444395983000}, "score": 30.798595, "resource": {"primary": {"URL": "http://www.palgraveconnect.com/doifinder/10.1057/9781137292094.0015"}}, "issued": {"date-parts": [[null]]}, "ISBN": ["9781137292094"], "references-count": 0, "URL": "https://doi.org/10.1057/9781137292094.0015"}, {"indexed": {"date-parts": [[2026, 8, 26]], "date-time": "2026-08-26T01:18:09Z", "timestamp": 1787707089751, "version": "build-2784847793"}, "reference-count": 0, "publisher": "Auricle Technologies, Pvt., Ltd.", "issue": "2", "license": [{"start": {"date-parts": [[2026, 8, 21]], "date-time": "2026-08-21T00:00:00Z", "timestamp": 1787270400000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["jidmis"], "abstract": "<jats:p>Automatic Speech Recognition (ASR) has seen tremendous advancements in recent times with the introduction of agentic frameworks for computer assisted pronunciation training (CAPT). The primary modules of a CAPT system are pronunciation assessment and feedback. The existing approaches often lack stability and an inability to adapt to learner-specific pronunciation parameters. The proposed work proposes a reinforcement learning (RL) induced self-reflective diagnostics (SRD) based agentic framework. This paper proposes a multi-stage, Wasserstein Generative Adversarial Networks with Gradient Penalty based agentic pronunciation assessment model. The proposed system models the canonical phoneme embeddings and the pronunciation deviation estimates using a Wasserstein distance\u2013based metric, enabling fine-grained and stable phoneme-level assessment. A closed-loop optimization mechanism enables autonomous reinforcement learning by generating adaptive feedback for phoneme generation and score assessment. The self-reflective diagnostic module ensures clarity and pedagogical quality by monitoring the feedback quality. The current state-of-the-art models like GAN, LLM based diagnosis fail to deliver context awareness in the corrective feedback for phoneme deviations. The multimodal large language model generates the context aware dynamic feedback. Experimental results show noticeable in the word-level mean accuracy from 98.9% for Whisper based GAN model to 99.4% for WGAN-GP based framework with RL and SRD. Compared with representative state-of-the-art baselines, including GOP-based scoring, self-supervised mispronunciation detection, and LLM-based diagnosis, the proposed approach achieves higher sentence-, word-, and letter-level accuracy of about 99% in each criteria , significantly lower phoneme deviation with mean MSE 0.14, and improved feedback consistency with 99.5% clarity. The results confirm that ensembling distribution-aware agentic optimization and self-reflective control based generative model generate a robust and adaptive pronunciation learning architecture optimized for real-world CAPT applications</jats:p>", "DOI": "10.59543/jidmis.v3.2227", "type": "journal-article", "created": {"date-parts": [[2026, 8, 22]], "date-time": "2026-08-22T09:39:18Z", "timestamp": 1787391558000}, "page": "1762-1772", "source": "Crossref", "is-referenced-by-count": 0, "title": ["A Self-Reflective Agentic Framework for Adaptive Pronunciation Assessment and Multimodal Feedback"], "prefix": "10.17762", "volume": "3", "author": [{"family": "Chesta Agarwal, Pinaki Chakraborty", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "7172", "published-online": {"date-parts": [[2026, 8, 21]]}, "container-title": ["Journal of Intelligent Decision Making and Information Science"], "link": [{"URL": "https://jidmis.org/index.php/jidmis/article/download/2227/938", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://jidmis.org/index.php/jidmis/article/download/2227/938", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 8, 26]], "date-time": "2026-08-26T00:22:19Z", "timestamp": 1787703739000}, "score": 29.754873, "resource": {"primary": {"URL": "https://jidmis.org/index.php/jidmis/article/view/2227"}}, "issued": {"date-parts": [[2026, 8, 21]]}, "references-count": 0, "journal-issue": {"issue": "2", "published-online": {"date-parts": [[2026, 7, 15]]}}, "URL": "https://doi.org/10.59543/jidmis.v3.2227", "ISSN": ["3079-0875"], "issn-type": [{"value": "3079-0875", "type": "electronic"}], "published": {"date-parts": [[2026, 8, 21]]}}, {"indexed": {"date-parts": [[2024, 10, 17]], "date-time": "2024-10-17T04:19:20Z", "time