{"data": {"id": "10.48550/arxiv.2210.03347", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2210.03347", "prefix": "10.48550", "suffix": "arxiv.2210.03347", "identifiers": [{"identifier": "2210.03347", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2210.03347"}], "creators": [{"name": "Lee, Kenton", "nameType": "Personal", "givenName": "Kenton", "familyName": "Lee", "affiliation": [], "nameIdentifiers": []}, {"name": "Joshi, Mandar", "nameType": "Personal", "givenName": "Mandar", "familyName": "Joshi", "affiliation": [], "nameIdentifiers": []}, {"name": "Turc, Iulia", "nameType": "Personal", "givenName": "Iulia", "familyName": "Turc", "affiliation": [], "nameIdentifiers": []}, {"name": "Hu, Hexiang", "nameType": "Personal", "givenName": "Hexiang", "familyName": "Hu", "affiliation": [], "nameIdentifiers": []}, {"name": "Liu, Fangyu", "nameType": "Personal", "givenName": "Fangyu", "familyName": "Liu", "affiliation": [], "nameIdentifiers": []}, {"name": "Eisenschlos, Julian", "nameType": "Personal", "givenName": "Julian", "familyName": "Eisenschlos", "affiliation": [], "nameIdentifiers": []}, {"name": "Khandelwal, Urvashi", "nameType": "Personal", "givenName": "Urvashi", "familyName": "Khandelwal", "affiliation": [], "nameIdentifiers": []}, {"name": "Shaw, Peter", "nameType": "Personal", "givenName": "Peter", "familyName": "Shaw", "affiliation": [], "nameIdentifiers": []}, {"name": "Chang, Ming-Wei", "nameType": "Personal", "givenName": "Ming-Wei", "familyName": "Chang", "affiliation": [], "nameIdentifiers": []}, {"name": "Toutanova, Kristina", "nameType": "Personal", "givenName": "Kristina", "familyName": "Toutanova", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Pix2Struct: Screenshot Parsing as Pretraining for Visual Language Understanding"}], "publisher": "arXiv", "container": {}, "publicationYear": 2022, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Computer Vision and Pattern Recognition (cs.CV)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2022-10-07T06:42:06Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2022-10-10T00:07:27Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2023-06-15T21:34:23Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2023-06-19T00:04:03Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2022-10", "dateType": "Available", "dateInformation": "v1"}, {"date": "2022", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rights": "Creative Commons Attribution 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "Visually-situated language is ubiquitous -- sources range from textbooks with diagrams to web pages with images and tables, to mobile apps with buttons and forms. Perhaps due to this diversity, previous work has typically relied on domain-specific recipes with limited sharing of the underlying data, model architectures, and objectives. We present Pix2Struct, a pretrained image-to-text model for purely visual language understanding, which can be finetuned on tasks containing visually-situated language. Pix2Struct is pretrained by learning to parse masked screenshots of web pages into simplified HTML. The web, with its richness of visual elements cleanly reflected in the HTML structure, provides a large source of pretraining data well suited to the diversity of downstream tasks. Intuitively, this objective subsumes common pretraining signals such as OCR, language modeling, image captioning. In addition to the novel pretraining strategy, we introduce a variable-resolution input representation and a more flexible integration of language and vision inputs, where language prompts such as questions are rendered directly on top of the input image. For the first time, we show that a single pretrained model can achieve state-of-the-art results in six out of nine tasks across four domains: documents, illustrations, user interfaces, and natural images.", "descriptionType": "Abstract"}, {"description": "Accepted at ICML", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2210.03347", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2022-10-10T00:46:36.000Z", "registered": "2022-10-10T00:46:37.000Z", "published": "2022", "updated": "2023-06-19T01:22:40.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2210.03347", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}