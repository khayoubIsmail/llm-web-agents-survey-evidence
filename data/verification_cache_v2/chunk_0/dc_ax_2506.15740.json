{"data": {"id": "10.48550/arxiv.2506.15740", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2506.15740", "prefix": "10.48550", "suffix": "arxiv.2506.15740", "identifiers": [{"identifier": "2506.15740", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2506.15740"}], "creators": [{"name": "Kutasov, Jonathan", "nameType": "Personal", "givenName": "Jonathan", "familyName": "Kutasov", "affiliation": [], "nameIdentifiers": []}, {"name": "Sun, Yuqi", "nameType": "Personal", "givenName": "Yuqi", "familyName": "Sun", "affiliation": [], "nameIdentifiers": []}, {"name": "Colognese, Paul", "nameType": "Personal", "givenName": "Paul", "familyName": "Colognese", "affiliation": [], "nameIdentifiers": []}, {"name": "van der Weij, Teun", "nameType": "Personal", "givenName": "Teun", "familyName": "van der Weij", "affiliation": [], "nameIdentifiers": []}, {"name": "Petrini, Linda", "nameType": "Personal", "givenName": "Linda", "familyName": "Petrini", "affiliation": [], "nameIdentifiers": []}, {"name": "Zhang, Chen Bo Calvin", "nameType": "Personal", "givenName": "Chen Bo Calvin", "familyName": "Zhang", "affiliation": [], "nameIdentifiers": []}, {"name": "Hughes, John", "nameType": "Personal", "givenName": "John", "familyName": "Hughes", "affiliation": [], "nameIdentifiers": []}, {"name": "Deng, Xiang", "nameType": "Personal", "givenName": "Xiang", "familyName": "Deng", "affiliation": [], "nameIdentifiers": []}, {"name": "Sleight, Henry", "nameType": "Personal", "givenName": "Henry", "familyName": "Sleight", "affiliation": [], "nameIdentifiers": []}, {"name": "Tracy, Tyler", "nameType": "Personal", "givenName": "Tyler", "familyName": "Tracy", "affiliation": [], "nameIdentifiers": []}, {"name": "Shlegeris, Buck", "nameType": "Personal", "givenName": "Buck", "familyName": "Shlegeris", "affiliation": [], "nameIdentifiers": []}, {"name": "Benton, Joe", "nameType": "Personal", "givenName": "Joe", "familyName": "Benton", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "SHADE-Arena: Evaluating Sabotage and Monitoring in LLM Agents"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Cryptography and Security (cs.CR)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Machine Learning (cs.LG)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-06-17T15:46:15Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-06-23T00:01:36Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-07-08T21:23:22Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2025-07-10T00:07:17Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2025-06", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "As Large Language Models (LLMs) are increasingly deployed as autonomous agents in complex and long horizon settings, it is critical to evaluate their ability to sabotage users by pursuing hidden objectives. We study the ability of frontier LLMs to evade monitoring and achieve harmful hidden goals while completing a wide array of realistic tasks. We evaluate a broad range of frontier LLMs using SHADE (Subtle Harmful Agent Detection &amp; Evaluation)-Arena, the first highly diverse agent evaluation dataset for sabotage and monitoring capabilities of LLM agents. SHADE-Arena consists of complex pairs of benign main tasks and harmful side objectives in complicated environments. Agents are evaluated on their ability to complete the side task without appearing suspicious to an LLM monitor. When measuring agent ability to (a) complete the main task, (b) complete the side task, and (c) avoid detection, we find that the best performing frontier models score 27% (Claude 3.7 Sonnet) and 15% (Gemini 2.5 Pro) as sabotage agents when overseen by Claude 3.6 Sonnet. For current frontier models, success on the side task relies heavily on having access to a hidden scratchpad that is not visible to the monitor. We also use SHADE-Arena to measure models' monitoring abilities, with the top monitor (Gemini 2.5 Pro) achieving an AUC of 0.87 at distinguishing benign and malign transcripts. We find that for now, models still struggle at sabotage due to failures in long-context main task execution. However, our measurements already demonstrate the difficulty of monitoring for subtle sabotage attempts, which we expect to only increase in the face of more complex and longer-horizon tasks.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2506.15740", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-06-23T02:14:44.000Z", "registered": "2025-06-23T02:14:44.000Z", "published": "2025", "updated": "2025-07-11T02:00:54.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2506.15740", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}