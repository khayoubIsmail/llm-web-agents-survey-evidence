x": "10.32388", "author": [{"ORCID": "https://orcid.org/0000-0003-0206-0616", "authenticated-orcid": true, "given": "\u00c2ngelo", "family": "Fonseca", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "17262", "link": [{"URL": "https://www.qeios.com/read/WVKIWE/pdf", "content-type": "application/pdf", "content-version": "vor", "intended-application": "unspecified"}, {"URL": "https://www.qeios.com/read/WVKIWE/pdf", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2025, 2, 24]], "date-time": "2025-02-24T13:46:22Z", "timestamp": 1740404782000}, "score": 29.586288, "resource": {"primary": {"URL": "https://www.qeios.com/read/WVKIWE"}}, "issued": {"date-parts": [[2025, 2, 24]]}, "references-count": 0, "URL": "https://doi.org/10.32388/wvkiwe", "relation": {"is-review-of": [{"id-type": "doi", "id": "10.32388/VN3YH7", "asserted-by": "subject"}]}, "published": {"date-parts": [[2025, 2, 24]]}}, {"indexed": {"date-parts": [[2026, 5, 21]], "date-time": "2026-05-21T19:47:31Z", "timestamp": 1779392851557, "version": "3.53.1"}, "reference-count": 0, "publisher": "Qeios Ltd", "content-domain": {"domain": []}, "published-print": {"date-parts": [[2025, 3, 2]]}, "DOI": "10.32388/fnye02", "type": "peer-review", "created": {"date-parts": [[2025, 3, 2]], "date-time": "2025-03-02T09:51:47Z", "timestamp": 1740909107000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Review of: \"MedAgentBench: A Realistic Virtual EHR Environment to Benchmark Medical LLM Agents\""], "prefix": "10.32388", "author": [{"ORCID": "https://orcid.org/0000-0003-0987-8007", "authenticated-orcid": true, "given": "Sebastian", "family": "Spethmann", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "17262", "link": [{"URL": "https://www.qeios.com/read/FNYE02/pdf", "content-type": "application/pdf", "content-version": "vor", "intended-application": "unspecified"}, {"URL": "https://www.qeios.com/read/FNYE02/pdf", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2025, 3, 2]], "date-time": "2025-03-02T09:51:47Z", "timestamp": 1740909107000}, "score": 29.55382, "resource": {"primary": {"URL": "https://www.qeios.com/read/FNYE02"}}, "issued": {"date-parts": [[2025, 3, 2]]}, "references-count": 0, "URL": "https://doi.org/10.32388/fnye02", "relation": {"is-review-of": [{"id-type": "doi", "id": "10.32388/VN3YH7", "asserted-by": "subject"}]}, "published": {"date-parts": [[2025, 3, 2]]}}, {"indexed": {"date-parts": [[2026, 8, 29]], "date-time": "2026-08-29T02:23:24Z", "timestamp": 1787970204455, "version": "build-2784847793"}, "reference-count": 0, "publisher": "Shiharr Publishing Limited", "issue": "1", "license": [{"start": {"date-parts": [[2026, 8, 5]], "date-time": "2026-08-05T00:00:00Z", "timestamp": 1785888000000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["dsai"], "abstract": "<jats:p>Penetration testing has long resisted full automation because it requires contextual reasoning, adaptive tool use, and experience-driven decision making across the Penetration Testing Execution Standard (PTES) lifecycle. Recent advances in large language models (LLMs), agentic reasoning, and multi-tool invocation have shifted the field from rule-based scripts and attack-graph reinforcement-learning planners toward interactive agents capable of planning, reflection, and environment interaction. The accompanying literature, however, suffers from inconsistent evaluation protocols, opaque scaffolding, and indiscriminate mixing of peer-reviewed papers with vendor self-reports, rendering headline claims difficult to compare. This work presents a critical narrative review with structured evidence charting of AI-assisted automated penetration testing between January 2023 and May 2026, retaining DeepExploit and AutoPentest-DRL as historical anchors. We introduce a dual-axis framework that annotates every finding by environment realism (R1\u2013R4, from single-challenge CTFs to live enterprise networks) and source authority (A\u2013D, from peer review to vendor self-report). Frontier agents reach 22\u201344% on R1 single-challenge CTFs (D-CIPHER), 79.17% on R2 AutoPenBench subtasks with a domain-tuned 32B model (xOffense), and 71.4% on the AISI 95-task expert tier (GPT-5.5), yet only 20\u201330% end-to-end completion on the R3 32-step TLO cyber range. On R4 live enterprise networks, the ARTEMIS multi-agent framework placed second overall against ten human professionals on an 8,000-host university network, submitting nine valid vulnerabilities at an 82% acceptance rate. Robust autonomy remains weak in long-horizon exploitation, Active Directory lateral movement, and defender-present environments. We argue that automated penetration testing is best framed as a systems-engineering problem rather than a single-model race, and we distinguish engineering-tractable Type A capability gaps from planning-bottlenecked Type B failures that require base-model reasoning improvements or reinforcement-learning post-training.</jats:p>", "DOI": "10.71411/dsai.2026.v1i1.1768", "type": "journal-article", "created": {"date-parts": [[2026, 8, 5]], "date-time": "2026-08-05T09:34:16Z", "timestamp": 1785922456000}, "page": "41-59", "source": "Crossref", "is-referenced-by-count": 0, "title": ["A Critical Review of LLM Agents for Automated Penetration Testing: Benchmark Realism and Evidence Grading"], "prefix": "10.71411", "volume": "1", "author": [{"given": "Zhou", "family": "Yinhang", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Xu", "family": "Weihua", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "52353", "published-online": {"date-parts": [[2026, 8, 5]]}, "container-title": ["\u6578\u64da\u79d1\u5b78\u8207\u4eba\u5de5\u667a\u80fd\u5b78\u5831"], "link": [{"URL": "https://ojs.shiharr.com/index.php/DSAI/article/download/1768/998", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://ojs.shiharr.com/index.php/DSAI/article/download/1768/998", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 8, 29]], "date-time": "2026-08-29T01:54:32Z", "timestamp": 1787968472000}, "score": 27.260715, "resource": {"primary": {"URL": "https://ojs.shiharr.com/index.php/DSAI/article/view/1768"}}, "issued": {"date-parts": [[2026, 8, 5]]}, "references-count": 0, "journal-issue": {"issue": "1", "published-online": {"date-parts": [[2026, 8, 5]]}}, "URL": "https://doi.org/10.71411/dsai.2026.v1i1.1768", "ISSN": ["3135-3045", "3135-3037"], "issn-type": [{"value": "3135-3045", "type": "electronic"}, {"value": "3135-3037", "type": "print"}], "published": {"date-parts": [[2026, 8, 5]]}}], "items-per-page": 5, "query": {"start-index": 0, "search-terms": null}}}