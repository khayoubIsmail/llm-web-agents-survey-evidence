, "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 2, 23]], "date-time": "2026-02-23T20:47:25Z", "timestamp": 1771879645000}, "score": 33.632683, "resource": {"primary": {"URL": "https://ieeexplore.ieee.org/document/11404291/"}}, "issued": {"date-parts": [[2026, 3]]}, "references-count": 20, "journal-issue": {"issue": "3"}, "URL": "https://doi.org/10.1109/mc.2025.3612810", "ISSN": ["0018-9162", "1558-0814"], "issn-type": [{"value": "0018-9162", "type": "print"}, {"value": "1558-0814", "type": "electronic"}], "published": {"date-parts": [[2026, 3]]}}, {"institution": [{"name": "Comprehensive R Archive Network", "acronym": ["CRAN"]}], "indexed": {"date-parts": [[2026, 5, 5]], "date-time": "2026-05-05T04:42:30Z", "timestamp": 1777956150234, "version": "3.51.4"}, "description": "Unified interface for creating LLM and Agent objects, generating responses and  performing batch inference based on a type-checked and validated 'S7' backend. Features  reasoning, structured output, memory management, and tool use. Supports 'Ollama'  <https://docs.ollama.com/api>,  'OpenAI'-compatible <https://developers.openai.com/api/reference/overview>, and  'Anthropic'-compatible <https://platform.claude.com/docs/en/api/getting-started> endpoints.", "reference-count": 0, "publisher": "The R Foundation", "content-domain": {"domain": [], "crossmark-restriction": false}, "content-updated": {"date-parts": [[2026, 5, 4]]}, "published-print": {"date-parts": [[2026, 5, 4]]}, "DOI": "10.32614/cran.package.rtemis.llm", "type": "dataset", "created": {"date-parts": [[2026, 5, 5]], "date-time": "2026-05-05T01:15:29Z", "timestamp": 1777943729000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["rtemis.llm: Large Language Models and Agentic AI"], "prefix": "10.32614", "author": [{"ORCID": "https://orcid.org/0000-0001-9280-3609", "authenticated-orcid": true, "given": "E.D.", "family": "Gennatas", "sequence": "first", "affiliation": [], "role": [{"role": "au