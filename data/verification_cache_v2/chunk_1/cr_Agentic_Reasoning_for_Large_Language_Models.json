"role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Sara", "family": "Dieter", "sequence": "additional", "affiliation": [{"name": "PricewaterhouseCoopers, U.S.A."}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Max", "family": "Harberg", "sequence": "additional", "affiliation": [{"name": "PricewaterhouseCoopers, U.S.A."}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Pradeep", "family": "Basavaraju", "sequence": "additional", "affiliation": [{"name": "PricewaterhouseCoopers, U.S.A."}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Vamse", "family": "Subbiah", "sequence": "additional", "affiliation": [{"name": "PricewaterhouseCoopers, U.S.A."}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "James", "family": "Burke", "sequence": "additional", "affiliation": [{"name": "PricewaterhouseCoopers, U.S.A."}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Roberto", "family": "Hernandez", "sequence": "additional", "affiliation": [{"name": "PricewaterhouseCoopers, U.S.A."}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "3171", "event": {"name": "18th International Conference on Agents and Artificial Intelligence", "location": "Marbella, Spain", "start": {"date-parts": [[2026, 3, 5]]}, "end": {"date-parts": [[2026, 3, 8]]}}, "container-title": ["Proceedings of the 18th International Conference on Agents and Artificial Intelligence"], "original-title": ["Rethinking Retrieval: From Traditional Retrieval Augmented Generation to Agentic and Non-Vector Reasoning Systems in the Financial Domain for Large Language Models"], "deposited": {"date-parts": [[2026, 5, 14]], "date-time": "2026-05-14T04:50:15Z", "timestamp": 1778734215000}, "score": 32.880245, "resource": {"primary": {"URL": "https://www.scitepress.org/DigitalLibrary/Link.aspx?doi=10.5220/0014492100004052"}}, "subtitle": [""], "issued": {"date-parts": [[2026]]}, "references-count": 0, "URL": "https://doi.org/10.5220/0014492100004052", "published": {"date-parts": [[2026]]}}, {"indexed": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T16:06:02Z", "timestamp": 1781280362797, "version": "3.54.1"}, "posted": {"date-parts": [[2025, 9, 11]]}, "reference-count": 0, "publisher": "Institute of Electrical and Electronics Engineers (IEEE)", "license": [{"start": {"date-parts": [[2025, 9, 11]], "date-time": "2025-09-11T00:00:00Z", "timestamp": 1757548800000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0/"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Recent progress in reasoning with large language models (LLMs) has been driven by prompting strategies such as Chain-of-Thought (CoT), Tree-of-Thought (ToT), Graph-of-Thought (GoT), and Hypergraph-of-Thought (HoT). Each introduces a powerful but fixed paradigm, forcing practitioners to manually select how a model should reason. In contrast, humans adapt their reasoning style-choosing between linear deduction, branching exploration, or relational inference depending on the task. We introduce Meta-of-Thought (MoT), a unifying controller that enables LLMs to reason about reasoning. MoT dynamically selects the most appropriate paradigm-CoT for arithmetic, ToT for planning, GoT for relational queries, and HoT for multimodal or scientific reasoning-closing the gap between fixed strategies and adaptive human cognition. A minimal rule-based prototype using flan-t5-small shows that MoT improves flexibility and robustness compared to static prompting. We position MoT as a step toward metacognitive LLMs that not only generate thoughts, but also decide how to think, opening a path for the next generation of reasoning research.</jats:p>", "DOI": "10.36227/techrxiv.175756693.33854887/v1", "type": "posted-content", "created": {"date-parts": [[2025, 9, 11]], "date-time": "2025-09-11T05:02:20Z", "timestamp": 1757566940000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Meta-of-Thought: Reasoning About Reasoning in Large Language Models"], "prefix": "10.36227", "author": [{"ORCID": "https://orcid.org/0000-0002-5571-7231", "authenticated-orcid": false, "given": "Ahshanul", "family": "Haque", "sequence": "first", "affiliation": [{"name": "Department of Computer Science, New Mexico Tech Socorro"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "263", "link": [{"URL": "https://www.techrxiv.org/doi/pdf/10.36227/techrxiv.175756693.33854887/v1", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T15:35:00Z", "timestamp": 1781278500000}, "score": 32.815258, "resource": {"primary": {"URL": "https://www.techrxiv.org/doi/full/10.36227/techrxiv.175756693.33854887/v1"}}, "issued": {"date-parts": [[2025, 9, 11]]}, "references-count": 0, "URL": "https://doi.org/10.36227/techrxiv.175756693.33854887/v1", "published": {"date-parts": [[2025, 9, 11]]}, "subtype": "preprint"}], "items-per-page": 5, "query": {"start-index": 0, "search-terms": null}}}