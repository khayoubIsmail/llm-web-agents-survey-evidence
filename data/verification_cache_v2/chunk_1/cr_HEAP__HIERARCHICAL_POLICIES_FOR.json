ce": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "2587", "event": {"number": "3", "sponsor": ["ICST"], "acronym": "WICON", "name": "3rd International ICSTConference on Wireless Internet", "start": {"date-parts": [[2007, 10, 22]]}, "location": "Austin (TX), USA", "end": {"date-parts": [[2007, 10, 24]]}}, "container-title": ["Proceedings of the 3rd International ICSTConference on Wireless Internet"], "deposited": {"date-parts": [[2024, 9, 21]], "date-time": "2024-09-21T16:14:16Z", "timestamp": 1726935256000}, "score": 18.959885, "resource": {"primary": {"URL": "http://eudl.eu/doi/10.4108/pwsn.2007.2286"}}, "proceedings-subject": "Wireless Internet", "issued": {"date-parts": [[2007]]}, "references-count": 0, "URL": "https://doi.org/10.4108/pwsn.2007.2286", "published": {"date-parts": [[2007]]}}, {"indexed": {"date-parts": [[2026, 8, 14]], "date-time": "2026-08-14T10:36:25Z", "timestamp": 1786703785819, "version": "build-2736575974"}, "posted": {"date-parts": [[2022]]}, "group-title": "SSRN", "reference-count": 0, "publisher": "Elsevier BV", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>The paper deals with the problem of learning tasks, where the robot is in permanent contact with the environment. We propose a new strategy based on a hierarchical learning scheme and representation of the task as a directed graph. The graph is built of nodes and branches, which correspond to the states and actions, respectively.The upper hierarchical level is essentially a decision-making algorithm. Optimal decision-making is supported using reinforcement learning (RL) techniques. The actions are generated by a constraint-space following (CSF) controller, which autonomously looks for directions where motion is possible. The controller generates robot motion by adjusting its stiffness in the direction defined by the Frenet-Serret frame attached to the robot path.The proposed framework was experimentally verified on challenging robot tasks such as maze learning, door opening, learning to shift the manual car gear, and learning car licence\u00a0 plate light assembly by disassembly.</jats:p>", "DOI": "10.2139/ssrn.4237312", "type": "posted-content", "created": {"date-parts": [[2022, 10, 4]], "date-time": "2022-10-04T23:10:55Z", "timestamp": 1664925055000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Hierarchical Learning of Robotic Contact Policies"], "prefix": "10.2139", "author": [{"ORCID": "https://orcid.org/0000-0002-0346-7082", "authenticated-orcid": true, "given": "Mihael", "family": "Simoni\u010d", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"ORCID": "https://orcid.org/0000-0003-3677-3972", "authenticated-orcid": true, "given": "Ale\u0161", "family": "Ude", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Bojan", "family": "Nemec", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "78", "deposited": {"date-parts": [[2026, 8, 14]], "date-time": "2026-08-14T10:11:25Z", "timestamp": 1786702285000}, "score": 17.939404, "resource": {"primary": {"URL": "https://www.ssrn.com/abstract=4237312"}}, "issued": {"date-parts": [[2022]]}, "references-count": 0, "URL": "https://doi.org/10.2139/ssrn.4237312", "published": {"date-parts": [[2022]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2022, 4, 3]], "date-time": "2022-04-03T09:43:11Z", "timestamp": 1648978991370}, "reference-count": 17, "publisher": "Elsevier BV", "issue": "2", "license": [{"start": {"date-parts": [[2009, 12, 1]], "date-time": "2009-12-01T00:00:00Z", "timestamp": 1259625600000}, "content-version": "tdm", "delay-in-days": 0, "URL": "https://www.elsevier.com/tdm/userlicense/1.0/"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["Information Proce