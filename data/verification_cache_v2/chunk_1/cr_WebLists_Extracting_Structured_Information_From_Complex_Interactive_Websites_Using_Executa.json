2, 8]]}}, {"indexed": {"date-parts": [[2026, 6, 19]], "date-time": "2026-06-19T10:51:23Z", "timestamp": 1781866283414, "version": "3.54.5"}, "reference-count": 0, "publisher": "The publishing house - SCIENTIFIC LIBRARY", "issue": "102", "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["SMC"], "published-print": {"date-parts": [[2026]]}, "abstract": "<jats:p>The paper considers the architecture of a deterministic pipeline for structuring unstructured text data using large language models (LLM). The integration of probabilistic language model generation with formal control mechanisms, including grammatically limited decoding, schema validation, and strict typing, is described. It is shown how such an architecture makes it possible to transform the stochastic LLM output into a reproducible process of obtaining correct structured data.</jats:p>", "DOI": "10.36871/2618-9976.2026.05.003", "type": "journal-article", "created": {"date-parts": [[2026, 6, 19]], "date-time": "2026-06-19T09:56:24Z", "timestamp": 1781862984000}, "page": "32-38", "source": "Crossref", "is-referenced-by-count": 0, "title": ["ARCHITECTURE OF A DETERMINISTIC PIPELINE FOR EXTRACTING STRUCTURED DATA FROM TEXT USING LLM"], "prefix": "10.36871", "volume": "5", "author": [{"given": "Nikita N.", "family": "Oltyan", "sequence": "first", "affiliation": [{"name": "Postgraduate Student, Financial University under the Government of the Russian Federation, Moscow, Russia"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Svetlana V.", "family": "Prokopchina", "sequence": "additional", "affiliation": [{"name": "Doctor of Technical Sciences, Professor, Financial University under the Government of the Russian Federation, Moscow, Russia"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "22926", "published-online": {"date-parts": [[2026]]}, "container-title": ["SOFT MEASUREMENTS AND COMPUTING"], "original-title": ["\u0410\u0420\u04