[{"given": "Pengcheng", "family": "Wen", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "5801", "deposited": {"date-parts": [[2026, 6, 29]], "date-time": "2026-06-29T23:02:28Z", "timestamp": 1782774148000}, "score": 33.0179, "degree": ["M.Phil."], "resource": {"primary": {"URL": "https://hdl.handle.net/1783.1/172505"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.14711/thesis-hdl172505"}, {"indexed": {"date-parts": [[2026, 2, 26]], "date-time": "2026-02-26T19:16:30Z", "timestamp": 1772133390640, "version": "3.50.1"}, "description": "Supplemental Information for 10.1021/jacs.5c02097", "reference-count": 0, "publisher": "American Chemical Society (ACS)", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.1021/jacs.5c02097.s001", "type": "component", "created": {"date-parts": [[2025, 7, 3]], "date-time": "2025-07-03T10:20:38Z", "timestamp": 1751538038000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Generative Design of Functional Metal Complexes Utilizing the Internal Knowledge and Reasoning Capability of Large Language Models"], "prefix": "10.1021", "member": "316", "deposited": {"date-parts": [[2025, 9, 10]], "date-time": "2025-09-10T07:55:49Z", "timestamp": 1757490949000}, "score": 31.983742, "resource": {"primary": {"URL": "https://pubs.acs.org/doi/suppl/10.1021/jacs.5c02097/suppl_file/ja5c02097_si_001.pdf"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.1021/jacs.5c02097.s001", "relation": {"is-component-of": [{"id-type": "doi", "id": "10.1021/jacs.5c02097", "asserted-by": "object"}]}}, {"indexed": {"date-parts": [[2026, 3, 11]], "date-time": "2026-03-11T18:42:26Z", "timestamp": 1773254546899, "version": "3.50.1"}, "posted": {"date-parts": [[2026, 3, 10]]}, "group-title": "Computer Science and Mathematics", "reference-count": 0, "publisher": "MDPI AG", "license": [{"start": {"date-parts": [[2026, 3, 10]], "date-time": "2026-03-10T00:00:00Z", "timestamp": 1773100800000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "http://creativecommons.org/licenses/by/4.0"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "accepted": {"date-parts": [[2026, 3, 9]]}, "abstract": "<jats:p>Large Reasoning Models (LRMs) face a fundamental challenge in balancing efficient \"fast thinking\" with accurate \"slow thinking,\" often struggling to adaptively trigger deeper reasoning without incurring significant computational overhead. This paper introduces \\( \\textit{MetaThink (MT)} \\), a novel inference-time adaptive refinement framework designed to imbue LRMs with conditional self-correction capabilities, without requiring any additional training. \\( \\textit{MetaThink} \\) operates by an initial \"fast thinking\" phase, followed by a lightweight self-monitoring mechanism that assesses confidence through uncertainty markers. When low confidence or potential errors are detected, a refinement token triggers a targeted \"slow thinking\" phase, guided by domain-specific prompts. This allows the model to introspectively review and correct its reasoning, culminating in a more accurate final answer. Our comprehensive evaluation across diverse and challenging benchmarks\u2014spanning mathematical reasoning, code generation, and scientific problem-solving tasks\u2014demonstrates that \\( \\textit{MetaThink} \\) consistently achieves substantial and robust improvements in Pass@1 accuracy. Crucially, these gains are realized while maintaining competitive or even improved inference efficiency, outperforming existing inference-time baselines. Our findings underscore that \\( \\textit{MetaThink} \\) offers an effective, training-free approach to enhance the reliability and accuracy of LRMs in complex reasoning tasks by striking a superior balance between performance and efficiency.</jats:p>", "DOI": "10.20944/preprints202603.0750.v1", "type": "posted-content", "created": {"date-parts": [[2026, 3, 11]], "date-time": "2026-03-11T01:09:54Z", "timestamp": 1773191394000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["MetaThink: Empowering Large Reasoning Models with Adaptive Self-Correction at Inference Time"], "prefix": "10.20944", "author": [{"given": "Jiarui", "family": "Qi", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Haoyu", "family": "Bian", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "1968", "deposited": {"date-parts": [[2026, 3, 11]], "date-time": "2026-03-11T01:10:47Z", "timestamp": 1773191447000}, "score": 30.799444, "resource": {"primary": {"URL": "https://www.preprints.org/manuscript/202603.0750/v1"}}, "issued": {"date-parts": [[2026, 3, 10]]}, "references-count": 0, "URL": "https://doi.org/10.20944/preprints202603.0750.v1", "published": {"date-parts": [[2026, 3, 10]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2025, 11, 20]], "date-time": "2025-11-20T06:19:45Z", "timestamp": 1763619585764, "version": "3.45.0"}, "posted": {"date-parts": [[2025]]}, "group-title": "SSRN", "reference-count": 0, "publisher": "Elsevier BV", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.2139/ssrn.5774579", "type": "posted-content", "created": {"date-parts": [[2025, 11, 20]], "date-time": "2025-11-20T05:43:11Z", "timestamp": 1763617391000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["When Correct Isn't Enough: Deconstructing Legal Causal Reasoning Capability in Large Language Models"], "prefix": "10.2139", "author": [{"given": "Jee Won", "family": "Park", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Sungmi", "family": "\u200dPark", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "78", 