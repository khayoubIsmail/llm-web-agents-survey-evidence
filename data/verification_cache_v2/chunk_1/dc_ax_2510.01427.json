{"data": {"id": "10.48550/arxiv.2510.01427", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2510.01427", "prefix": "10.48550", "suffix": "arxiv.2510.01427", "identifiers": [{"identifier": "2510.01427", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2510.01427"}], "creators": [{"name": "Zhang, Sipeng", "nameType": "Personal", "givenName": "Sipeng", "familyName": "Zhang", "affiliation": [], "nameIdentifiers": []}, {"name": "Yun, Longfei", "nameType": "Personal", "givenName": "Longfei", "familyName": "Yun", "affiliation": [], "nameIdentifiers": []}, {"name": "Wang, Zilong", "nameType": "Personal", "givenName": "Zilong", "familyName": "Wang", "affiliation": [], "nameIdentifiers": []}, {"name": "Peng, Letian", "nameType": "Personal", "givenName": "Letian", "familyName": "Peng", "affiliation": [], "nameIdentifiers": []}, {"name": "Shang, Jingbo", "nameType": "Personal", "givenName": "Jingbo", "familyName": "Shang", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "A Tale of LLMs and Induced Small Proxies: Scalable Small Language Models for Knowledge Mining"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-10-01T20:06:48Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-10-03T00:08:57Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-10-15T07:21:03Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2025-10-16T00:31:37Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-06-04T21:01:10Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2026-06-08T00:09:34Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2026-07-30T00:32:01Z", "dateType": "Submitted", "dateInformation": "v4"}, {"date": "2026-07-31T00:14:50Z", "dateType": "Updated", "dateInformation": "v4"}, {"date": "2025-10", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "4", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "At the core of Deep Research is knowledge mining, the task of extracting structured information from massive unstructured text in response to user instructions. Large language models (LLMs) excel at interpreting such instructions but are prohibitively expensive to deploy at scale, while traditional pipelines of classifiers and extractors remain efficient yet brittle and unable to generalize to new tasks. We introduce Falconer, a collaborative framework that combines the agentic reasoning of LLMs with lightweight proxy models for scalable knowledge mining. In Falconer, LLMs act as planners, decomposing user instructions into executable pipelines, and as annotators, generating supervision to train small proxies. The framework unifies classification and extraction into two atomic operations, get label and get span, enabling a single instruction-following model to replace multiple task-specific components. To evaluate the consistency between proxy models incubated by Falconer and annotations provided by humans and large models, we construct new benchmarks covering both planning and end-to-end execution. Experiments show that Falconer closely matches state-of-the-art LLMs in instruction-following accuracy while reducing inference cost by up to 90% and accelerating large-scale knowledge mining by more than 20x, offering an efficient and scalable foundation for Deep Research.", "descriptionType": "Abstract"}, {"description": "Code available: https://github.com/LongfeiYun17/falconer", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2510.01427", "contentUrl": null, "metadataVersion": 3, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-10-03T01:48:50.000Z", "registered": "2025-10-03T01:48:51.000Z", "published": "2025", "updated": "2026-07-31T02:35:15.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2510.01427", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}