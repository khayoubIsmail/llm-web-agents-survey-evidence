{"data": {"id": "10.48550/arxiv.2410.02052", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2410.02052", "prefix": "10.48550", "suffix": "arxiv.2410.02052", "identifiers": [{"identifier": "2410.02052", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2410.02052"}], "creators": [{"name": "Yu, Xiao", "nameType": "Personal", "givenName": "Xiao", "familyName": "Yu", "affiliation": [], "nameIdentifiers": []}, {"name": "Peng, Baolin", "nameType": "Personal", "givenName": "Baolin", "familyName": "Peng", "affiliation": [], "nameIdentifiers": []}, {"name": "Vajipey, Vineeth", "nameType": "Personal", "givenName": "Vineeth", "familyName": "Vajipey", "affiliation": [], "nameIdentifiers": []}, {"name": "Cheng, Hao", "nameType": "Personal", "givenName": "Hao", "familyName": "Cheng", "affiliation": [], "nameIdentifiers": []}, {"name": "Galley, Michel", "nameType": "Personal", "givenName": "Michel", "familyName": "Galley", "affiliation": [], "nameIdentifiers": []}, {"name": "Gao, Jianfeng", "nameType": "Personal", "givenName": "Jianfeng", "familyName": "Gao", "affiliation": [], "nameIdentifiers": []}, {"name": "Yu, Zhou", "nameType": "Personal", "givenName": "Zhou", "familyName": "Yu", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "ExACT: Teaching AI Agents to Explore with Reflective-MCTS and Exploratory Learning"}], "publisher": "arXiv", "container": {}, "publicationYear": 2024, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Computer Vision and Pattern Recognition (cs.CV)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2024-10-02T21:42:35Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2024-10-04T00:13:48Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2024-10-15T14:59:46Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2024-10-16T01:02:13Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2024-10-18T03:27:37Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2024-10-21T00:23:32Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2025-01-13T19:51:53Z", "dateType": "Submitted", "dateInformation": "v4"}, {"date": "2025-01-15T01:04:05Z", "dateType": "Updated", "dateInformation": "v4"}, {"date": "2025-02-27T20:13:19Z", "dateType": "Submitted", "dateInformation": "v5"}, {"date": "2025-03-03T01:04:58Z", "dateType": "Updated", "dateInformation": "v5"}, {"date": "2024-10", "dateType": "Available", "dateInformation": "v1"}, {"date": "2024", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "5", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Autonomous agents have demonstrated significant potential in automating complex multistep decision-making tasks. However, even state-of-the-art vision-language models (VLMs), such as GPT-4o, still fall short of human-level performance, particularly in intricate web environments and long-horizon tasks. To address these limitations, we present ExACT, an approach to combine test-time search and self-learning to build o1-like models for agentic applications. We first introduce Reflective Monte Carlo Tree Search (R-MCTS), a novel test time algorithm designed to enhance AI agents' ability to explore decision space on the fly. R-MCTS extends traditional MCTS by 1) incorporating contrastive reflection, allowing agents to learn from past interactions and dynamically improve their search efficiency; and 2) using multi-agent debate for reliable state evaluation. Next, we introduce Exploratory Learning, a novel learning strategy to teach agents to search at inference time without relying on any external search algorithms. On the challenging VisualWebArena benchmark, our GPT-4o based R-MCTS agent achieves a 6% to 30% relative improvement across various tasks compared to the previous state-of-the-art. Additionally, we show that the knowledge and experience gained from test-time search can be effectively transferred back to GPT-4o via fine-tuning. After Exploratory Learning, GPT-4o 1) demonstrates the ability to explore the environment, evaluate a state, and backtrack to viable ones when it detects that the current state cannot lead to success, and 2) matches 87% of R-MCTS's performance while using significantly less compute. Notably, our work demonstrates the compute scaling properties in both training - data collection with R-MCTS - and testing time. These results suggest a promising research direction to enhance VLMs' capabilities for agentic applications via test-time search and self-learning.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2410.02052", "contentUrl": null, "metadataVersion": 4, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2024-10-04T02:13:05.000Z", "registered": "2024-10-04T02:13:06.000Z", "published": "2024", "updated": "2025-03-03T03:22:05.000Z"}, "relationships": {"client":