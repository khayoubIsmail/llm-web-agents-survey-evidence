ain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2025, 12, 31]]}, "DOI": "10.1515/9780691263786-004", "type": "book-chapter", "created": {"date-parts": [[2025, 11, 19]], "date-time": "2025-11-19T08:20:06Z", "timestamp": 1763540406000}, "page": "xiii-xx", "source": "Crossref", "is-referenced-by-count": 0, "title": ["Introduction: Never-Ending Jewish Tales and the Jewish Question"], "prefix": "10.1515", "member": "374", "container-title": ["Never-Ending Tales"], "link": [{"URL": "https://www.degruyterbrill.com/document/doi/10.1515/9780691263786-004/xml", "content-type": "application/xml", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://www.degruyterbrill.com/document/doi/10.1515/9780691263786-004/pdf", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 9, 7]], "date-time": "2026-09-07T13:42:45Z", "timestamp": 1788788565000}, "score": 26.188406, "resource": {"primary": {"URL": "https://www.degruyterbrill.com/document/doi/10.1515/9780691263786-004/html"}}, "issued": {"date-parts": [[2025, 12, 31]]}, "ISBN": ["9780691263786"], "references-count": 0, "alternative-id": ["10.1515/9780691263786-004", "10.1515/9780691263786"], "URL": "https://doi.org/10.1515/9780691263786-004", "relation": {"is-identical-to": [{"id-type": "doi", "id": "10.2307/jj.29871088.4", "asserted-by": "object"}]}, "published": {"date-parts": [[2025, 12, 31]]}}, {"indexed": {"date-parts": [[2024, 9, 13]], "date-time": "2024-09-13T05:31:33Z", "timestamp": 1726205493743}, "edition-number": "3", "reference-count": 0, "publisher": "Oxford University Press", "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2023, 3, 2]]}, "DOI": "10.1093/oed/7029776859", "type": "book-chapter", "created": {"date-parts": [[2023, 7, 18]], "date-time": "2023-07-18T16:05:10Z", "timestamp": 1689696310000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["never-ending, adj."], "prefix": "10.1093", "member": "286", "container-title": ["Oxford English Dictionary"], "language": "en", "deposited": {"date-parts": [[2023, 7, 18]], "date-time": "2023-07-18T16:07:07Z", "timestamp": 1689696427000}, "score": 26.084826, "resource": {"primary": {"URL": "https://oed.com/dictionary/never-ending_adj"}}, "issued": {"date-parts": [[2023, 3, 2]]}, "references-count": 0, "URL": "https://doi.org/10.1093/oed/7029776859", "published": {"date-parts": [[2023, 3, 2]]}}, {"indexed": {"date-parts": [[2026, 2, 27]], "date-time": "2026-02-27T05:14:16Z", "timestamp": 1772169256534, "version": "3.50.1"}, "reference-count": 0, "publisher": "Policy Press", "isbn-type": [{"value": "9781529209334", "type": "print"}, {"value": "9781529209372", "type": "electronic"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2024, 11, 19]]}, "abstract": "<p>Chapter 6 explores the ongoing influence of austerity on society and policy, moving beyond its immediate effects. Building on the book\u2019s analysis, it examines how temporal narratives shape public perceptions and limit political possibilities. The chapter dismantles the notion of a finite retrenchment period, initially envisioned, revealing a more permanent state of austerity. It analyses how governments frame austerity as a crisis response, potentially obfuscating its long-term consequences for life trajectories and social and geographical inequalities. This framing, the chapter argues, serves to deflect electoral punishment for austerity measures. Furthermore, the chapter highlights how recent events like Brexit and the COVID-19 pandemic have reshaped the discourse surrounding austerity in the UK, with pronouncements of austerity\u2019s \u2018end\u2019 demonstrably misleading. These pronouncements obscure the reality of continued austerity, fuelling resentment in \u2018left-behind places\u2019 where residents face increasingly limited opportunities for advancement. The book\u2019s critical examination of austerity\u2019s narratives and long-term consequences thus provides a compelling rationale for prioritizing alternative policy approaches that invest in social wellbeing and geographical equity. Because the long-term consequences of austerity cannot be permanently obscured, a shift towards alternative approaches becomes increasingly imperative.</p>", "DOI": "10.1332/policypress/9781529209334.003.0006", "type": "book-chapter", "created": {"date-parts": [[2025, 5, 23]], "date-time": "2025-05-23T10:39:59Z", "timestamp": 1747996799000}, "page": "112-126", "source": "Crossref", "is-referenced-by-count": 0, "title": ["Ending or Never-Ending Austerity?"], "prefix": "10.1332", "author": [{"given": "Julie", "family": "MacLeavy", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "165", "published-online": {"date-parts": [[2025, 5, 22]]}, "container-title": ["Enduring Austerity"], "original-title": ["Ending or Never-Ending Austerity?"], "language": "en", "deposited": {"date-parts": [[2025, 5, 23]], "date-time": "2025-05-23T10:39:59Z", "timestamp": 1747996799000}, "score": 26.08369, "resource": {"primary": {"URL": "https://academic.oup.com/policy-press-scholarship-online/book/60199/chapter/519984783"}}, "issued": {"date-parts": [[2024, 11, 19]]}, "ISBN": ["9781529209334", "9781529209372"], "references-count": 0, "URL": "https://doi.org/10.1332/policypress/9781529209334.003.0006", "relation": {"is-identical-to": [{"id-type": "doi", "id": "10.51952/9781529209358.ch006", "asserted-by": "object"}]}, "published": {"date-parts": [[2024, 11, 19]]}}], "items-per-page": 10, "query": {"start-index": 0, "search-terms": null}}}