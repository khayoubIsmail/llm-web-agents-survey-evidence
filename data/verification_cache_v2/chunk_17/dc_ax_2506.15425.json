{"data": {"id": "10.48550/arxiv.2506.15425", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2506.15425", "prefix": "10.48550", "suffix": "arxiv.2506.15425", "identifiers": [{"identifier": "2506.15425", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2506.15425"}], "creators": [{"name": "Tao, Xingjian", "nameType": "Personal", "givenName": "Xingjian", "familyName": "Tao", "affiliation": [], "nameIdentifiers": []}, {"name": "Wang, Yiwei", "nameType": "Personal", "givenName": "Yiwei", "familyName": "Wang", "affiliation": [], "nameIdentifiers": []}, {"name": "Cai, Yujun", "nameType": "Personal", "givenName": "Yujun", "familyName": "Cai", "affiliation": [], "nameIdentifiers": []}, {"name": "Yang, Zhicheng", "nameType": "Personal", "givenName": "Zhicheng", "familyName": "Yang", "affiliation": [], "nameIdentifiers": []}, {"name": "Tang, Jing", "nameType": "Personal", "givenName": "Jing", "familyName": "Tang", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Understanding GUI Agent Localization Biases through Logit Sharpness"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-06-18T12:55:35Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-06-19T00:39:34Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-06", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "1", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Multimodal large language models (MLLMs) have enabled GUI agents to interact with operating systems by grounding language into spatial actions. Despite their promising performance, these models frequently exhibit hallucinations-systematic localization errors that compromise reliability. We propose a fine-grained evaluation framework that categorizes model predictions into four distinct types, revealing nuanced failure modes beyond traditional accuracy metrics. To better quantify model uncertainty, we introduce the Peak Sharpness Score (PSS), a metric that evaluates the alignment between semantic continuity and logits distribution in coordinate prediction. Building on this insight, we further propose Context-Aware Cropping, a training-free technique that improves model performance by adaptively refining input context. Extensive experiments demonstrate that our framework and methods provide actionable insights and enhance the interpretability and robustness of GUI agent behavior.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2506.15425", "contentUrl": null, "metadataVersion": 0, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-06-19T01:44:18.000Z", "registered": "2025-06-19T01:44:18.000Z", "published": "2025", "updated": "2025-06-19T01:44:18.000Z"}, "rela