44:47Z", "timestamp": 1756201487000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Temptation and exercise: how apps can help you make commitments you can\u2019t refuse"], "prefix": "10.64628", "author": [{"given": "David", "family": "Glance", "sequence": "first", "affiliation": [{"name": "The University of Western Australia"}], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "54080", "deposited": {"date-parts": [[2025, 8, 26]], "date-time": "2025-08-26T09:46:24Z", "timestamp": 1756201584000}, "score": 28.027082, "resource": {"primary": {"URL": "https://theconversation.com/temptation-and-exercise-how-apps-can-help-you-make-commitments-you-cant-refuse-45348"}}, "issued": {"date-parts": [[2015, 7, 28]]}, "references-count": 0, "URL": "https://doi.org/10.64628/aa.a6qesftc7", "published": {"date-parts": [[2015, 7, 28]]}, "subtype": "other"}, {"institution": [{"name": "Association for Child and Adolescent Mental Health", "acronym": ["ACAMH"]}], "indexed": {"date-parts": [[2023, 2, 17]], "date-time": "2023-02-17T05:39:09Z", "timestamp": 1676612349029}, "reference-count": 0, "publisher": "ACAMH", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p xml:lang=\"en\">We were delighted to welcome a top class panel of speakers to give evidence based advice and a lived experience perspective to parents, teachers, and clinicians. We are joined by Ursula Saunders, Dr. Alice Welham, Professor Roz Shafran authors of new book How to Cope When Your Child Can\u2019t. Also, we have the\u00a0Charlie Waller Trust\u00a0who are developing parent peer support as a crucial part of their work in addressing the mental health of children and young people. Offering evidence -based training and resources and using co-production with parents with lived experience, CWT\u2019s community includes renowned authorities on adolescent psychology, childhood anxiety and depression.</jats:p>", "DOI": "10.13056/acamh.20622", "type": "repor