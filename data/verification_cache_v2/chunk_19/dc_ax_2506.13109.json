{"data": {"id": "10.48550/arxiv.2506.13109", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2506.13109", "prefix": "10.48550", "suffix": "arxiv.2506.13109", "identifiers": [{"identifier": "2506.13109", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2506.13109"}], "creators": [{"name": "Gupta, Shivanshu", "nameType": "Personal", "givenName": "Shivanshu", "familyName": "Gupta", "affiliation": [], "nameIdentifiers": []}, {"name": "Singh, Sameer", "nameType": "Personal", "givenName": "Sameer", "familyName": "Singh", "affiliation": [], "nameIdentifiers": []}, {"name": "Sabharwal, Ashish", "nameType": "Personal", "givenName": "Ashish", "familyName": "Sabharwal", "affiliation": [], "nameIdentifiers": []}, {"name": "Khot, Tushar", "nameType": "Personal", "givenName": "Tushar", "familyName": "Khot", "affiliation": [], "nameIdentifiers": []}, {"name": "Bogin, Ben", "nameType": "Personal", "givenName": "Ben", "familyName": "Bogin", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Leveraging In-Context Learning for Language Model Agents"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-06-16T05:37:49Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-06-17T01:03:45Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-06", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "1", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "In-context learning (ICL) with dynamically selected demonstrations combines the flexibility of prompting large language models (LLMs) with the ability to leverage training data to improve performance. While ICL has been highly successful for prediction and generation tasks, leveraging it for agentic tasks that require sequential decision making is challenging -- one must think not only about how to annotate long trajectories at scale and how to select demonstrations, but also what constitutes demonstrations, and when and where to show them. To address this, we first propose an algorithm that leverages an LLM with retries along with demonstrations to automatically and efficiently annotate agentic tasks with solution trajectories. We then show that set-selection of trajectories of similar tasks as demonstrations significantly improves performance, reliability, robustness, and efficiency of LLM agents. However, trajectory demonstrations have a large inference cost overhead. We show that this can be mitigated by using small trajectory snippets at every step instead of an additional trajectory. We find that demonstrations obtained from larger models (in the annotation phase) also improve smaller models, and that ICL agents can even rival costlier trained agents. Thus, our results reveal that ICL, with careful use, can be very powerful for agentic tasks as well.", "descriptionType": "Abstract"}, {"description": "16 pages, 12 figures", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2506.13109", "contentUrl": null, "metadataVersion": 0, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-06-17T02:53:25.000Z", "registered": "2025-06-17T02:53:26.000Z", "published": "2025", "updated": "2025-06-17T02:53:26.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2506.13109", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}