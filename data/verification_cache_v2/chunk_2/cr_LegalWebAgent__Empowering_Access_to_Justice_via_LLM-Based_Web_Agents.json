:01:19Z", "timestamp": 1782774079000}, "approved": {"date-parts": [[2026]]}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Empowering LLM Agents with Knowledge, Tools, and Vision"], "prefix": "10.14711", "author": [{"given": "Zijian", "family": "Li", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "5801", "deposited": {"date-parts": [[2026, 6, 29]], "date-time": "2026-06-29T23:01:21Z", "timestamp": 1782774081000}, "score": 32.501236, "degree": ["Ph.D."], "resource": {"primary": {"URL": "https://hdl.handle.net/1783.1/172470"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.14711/thesis-hdl172470"}, {"indexed": {"date-parts": [[2026, 9, 5]], "date-time": "2026-09-05T15:31:44Z", "timestamp": 1788622304455, "version": "build-2803163510"}, "reference-count": 0, "publisher": "SCITEPRESS - Science and Technology Publications", "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2025]]}, "DOI": "10.5220/0013248800003890", "type": "proceedings-article", "created": {"date-parts": [[2025, 2, 28]], "date-time": "2025-02-28T12:43:20Z", "timestamp": 1740746600000}, "page": "1001-1008", "source": "Crossref", "is-referenced-by-count": 3, "title": ["Using LLM-Based Deep Reinforcement Learning Agents to Detect Bugs in Web Applications"], "prefix": "10.5220", "author": [{"given": "Yuki", "family": "Sakai", "sequence": "first", "affiliation": [{"name": "The University of Electro-Communications, Japan"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Yasuyuki", "family": "Tahara", "sequence": "additional", "affiliation": [{"name": "The University of Electro-Communications, Japan"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Akihiko", "family": "Ohsuga", "sequence": "additional", "affiliation": [{"name": "The University of Electro-Communications, Japan"}], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Yuichi", "family": "Sei", "sequence": "additional", "affiliation": [{"name": "The University of Electro-Communications, Japan"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "3171", "event": {"name": "17th International Conference on Agents and Artificial Intelligence", "location": "Porto, Portugal", "start": {"date-parts": [[2025, 2, 23]]}, "end": {"date-parts": [[2025, 2, 25]]}}, "container-title": ["Proceedings of the 17th International Conference on Agents and Artificial Intelligence"], "original-title": ["Using LLM-Based Deep Reinforcement Learning Agents to Detect Bugs in Web Applications"], "deposited": {"date-parts": [[2025, 3, 13]], "date-time": "2025-03-13T12:57:07Z", "timestamp": 1741870627000}, "score": 30.672684, "resource": {"primary": {"URL": "https://www.scitepress.org/DigitalLibrary/Link.aspx?doi=10.5220/0013248800003890"}}, "subtitle": [""], "issued": {"date-parts": [[2025]]}, "references-count": 0, "URL": "https://doi.org/10.5220/0013248800003890", "published": {"date-parts": [[2025]]}}, {"indexed": {"date-parts": [[2026, 9, 3]], "date-time": "2026-09-03T07:18:17Z", "timestamp": 1788419897356, "version": "build-2803163510"}, "posted": {"date-parts": [[2026]]}, "group-title": "SSRN", "reference-count": 0, "publisher": "Elsevier BV", "license": [{"start": {"date-parts": [[2026, 1, 1]], "date-time": "2026-01-01T00:00:00Z", "timestamp": 1767225600000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0/"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Autonomous web agents, powered by Large Language Models (LLMs), has garnered significant attention for automating various webbased tasks with multi-step reasoning and decision-making capabilities. An open research question in the development of these agents lies in the format of the webpage input. Raw HTML source code, with its extensive and often irrelevant details, poses difficulties for LLMs with limited context windows. To address the challenge, we first reproduce baseline models such as GPT-3.5 and LLaMA-2-70B on the WebArena (Zhou et al., 2023) benchmark, identifying common failure modes. We then proposed two retrieval strategies to filter out irrelevant context for LLM agents. We developed DeBERTa-based and T5-based models that can rank HTML elements by their relevance to the task. We finetuned them on Mind2Web trajectory data and transferred them to WebArena. Experiments show that our DeBERTa-based model enhances the success rate of the LLaMA-2-70B LLM agent on WebArena from 1.97% to 2.96%. Moreover, we developed zero-shot ColBERT-based retriever, which is able to retrieve the ground-truth element with a recall of 0.52 on Mind2Web and 0.47 on WebArena.</jats:p>", "DOI": "10.2139/ssrn.7390859", "type": "posted-content", "created": {"date-parts": [[2026, 9, 3]], "date-time": "2026-09-03T07:03:47Z", "timestamp": 1788419027000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Improving LLM-based Autonomous Web Agents with Filtering"], "prefix": "10.2139", "author": [{"given": "Ruiyu", "family": "Li", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Zhitong", "family": "Guo", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Jing Yu", "family": "Koh", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "78", "deposited": {"date-parts": [[2026, 9, 3]], "date-time": "2026-09-03T07:03:48Z", "timestamp": 1788419028000}, "score": 29.959557, "resource": {"primary": {"URL": "https://www.ssrn.com/abstract=7390859"}}, "issued": {"date-parts": [[2026]]}, "references-count": 0, "URL": "https://doi.org/10.2139/ssrn.7390859", "published": {"date-parts": [[2026]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[