T07:58:58Z", "timestamp": 1787212738000}, "score": 46.372124, "resource": {"primary": {"URL": "https://link.springer.com/10.1007/979-8-8688-3010-5_11"}}, "issued": {"date-parts": [[2026]]}, "ISBN": ["9798868830099", "9798868830105"], "references-count": 0, "URL": "https://doi.org/10.1007/979-8-8688-3010-5_11", "published": {"date-parts": [[2026]]}, "assertion": [{"value": "21 August 2026", "order": 1, "name": "first_online", "label": "First Online", "group": {"name": "ChapterHistory", "label": "Chapter History"}}]}, {"indexed": {"date-parts": [[2026, 8, 20]], "date-time": "2026-08-20T22:47:25Z", "timestamp": 1787266045022, "version": "build-2736575974"}, "posted": {"date-parts": [[2025, 4, 2]]}, "group-title": "Computer Science and Mathematics", "reference-count": 0, "publisher": "MDPI AG", "license": [{"start": {"date-parts": [[2025, 4, 2]], "date-time": "2025-04-02T00:00:00Z", "timestamp": 1743552000000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "http://creativecommons.org/licenses/by/4.0"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "accepted": {"date-parts": [[2025, 4, 2]]}, "abstract": "<jats:p>The Model Context Protocol (MCP), recently introduced by Anthropic, proposes a standardized framework for integrating large language models (LLMs) with dynamic external systems. This survey reviews the foundational architecture of MCP, including its client-server model, standardized messaging protocols, dynamic tool discovery, and security mechanisms, against the backdrop of current, fragmented API solutions. Although the protocol promises enhanced interoperability and scalability for Agentic AI systems, data supporting its long-term performance remains limited. MCP\u2019s design is critically evaluated, potential applications in domains such as finance, healthcare, and customer service are discussed, and the key challenges are outlined. This work aims to inform researchers and practitioners of MCP\u2019s potential benefits and its present limitations in the evolving AI integration landscape. The GitHub link for this survey is: Model-Context-Protocol-Survey.</jats:p>", "DOI": "10.20944/preprints202504.0245.v1", "type": "posted-content", "created": {"date-parts": [[2025, 4, 3]], "date-time": "2025-04-03T03:34:20Z", "timestamp": 1743651260000}, "source": "Crossref", "is-referenced-by-count": 23, "title": ["A Survey of the Model Context Protocol (MCP): Standardizing Context to Enhance Large Language Models (LLMs)"], "prefix": "10.20944", "author": [{"ORCID": "https://orcid.org/0000-0002-0082-8364", "authenticated-orcid": false, "given": "Aditi", "family": "Singh", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Abul", "family": "Ehtesham", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Saket", "family": "Kumar", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Tala Talaei", "family": "Khoei", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "1968", "deposited": {"date-parts": [[2025, 4, 3]], "date-time": "2025-04-03T03:38:20Z", "timestamp": 1743651500000}, "score": 45.917297, "resource": {"primary": {"URL": "https://www.preprints.org/manuscript/202504.0245/v1"}}, "issued": {"date-parts": [[2025, 4, 2]]}, "references-count": 0, "URL": "https://doi.org/10.20944/preprints202504.0245.v1", "published": {"date-parts": [[2025, 4, 2]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2026, 8, 20]], "date-time": "2026-08-20T08:24:37Z", "timestamp": 1787214277839, "version": "build-2736575974"}, "publisher-location": "Berkeley, CA", "reference-count": 0, "publisher": "Apress", "isbn-type": [{"value": "9798868830099", "type": "print"}, {"value": "9798868830105", "type": "electronic"}], "license": [{"start": {"date-parts": [[2026, 1, 1]], "date-time