3, "resource": {"primary": {"URL": "https://dl.acm.org/doi/10.1145/3543873.3587540"}}, "issued": {"date-parts": [[2023, 4, 30]]}, "references-count": 33, "alternative-id": ["10.1145/3543873.3587540", "10.1145/3543873"], "URL": "https://doi.org/10.1145/3543873.3587540", "published": {"date-parts": [[2023, 4, 30]]}, "assertion": [{"value": "2023-04-30", "order": 3, "name": "published", "label": "Published", "group": {"name": "publication_history", "label": "Publication History"}}]}, {"institution": [{"name": "\u0391\u03c1\u03b9\u03c3\u03c4\u03bf\u03c4\u03ad\u03bb\u03b5\u03b9\u03bf \u03a0\u03b1\u03bd\u03b5\u03c0\u03b9\u03c3\u03c4\u03ae\u03bc\u03b9\u03bf \u0398\u03b5\u03c3\u03c3\u03b1\u03bb\u03bf\u03bd\u03af\u03ba\u03b7\u03c2 (\u0391\u03a0\u0398), \u03a3\u03c7\u03bf\u03bb\u03ae \u0398\u03b5\u03c4\u03b9\u03ba\u03ce\u03bd \u0395\u03c0\u03b9\u03c3\u03c4\u03b7\u03bc\u03ce\u03bd, \u03a4\u03bc\u03ae\u03bc\u03b1 \u03a0\u03bb\u03b7\u03c1\u03bf\u03c6\u03bf\u03c1\u03b9\u03ba\u03ae\u03c2"}], "indexed": {"date-parts": [[2022, 4, 2]], "date-time": "2022-04-02T11:50:36Z", "timestamp": 1648900236747}, "reference-count": 0, "publisher": "National Documentation Centre (EKT)", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>\u03a4\u03b9\u03c2 \u03c4\u03b5\u03bb\u03b5\u03c5\u03c4\u03b1\u03af\u03b5\u03c2 \u03b4\u03b5\u03ba\u03b1\u03b5\u03c4\u03af\u03b5\u03c2, \u03ad\u03c7\u03bf\u03c5\u03bd \u03b3\u03af\u03bd\u03b5\u03b9 \u03c0\u03bf\u03bb\u03bb\u03ac \u03b2\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c0\u03c1\u03bf\u03cc\u03b4\u03bf\u03c5 \u03b3\u03cd\u03c1\u03c9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7 \u03c0\u03c1\u03b1\u03ba\u03c4\u03cc\u03c1\u03c9\u03bd \u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03b9\u03ba\u03bf\u03cd \u03c0\u03bf\u03c5 \u03b1\u03bb\u03bb\u03b7\u03bb\u03b5\u03c0\u03b9\u03b4\u03c1\u03bf\u03cd\u03bd \u03bc\u03b5 \u03c4\u03bf\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf \u03bc\u03ad\u03c3\u03c9 \u03c6\u03c5\u03c3\u03b9\u03ba\u03ae\u03c2 \u03b3\u03bb\u03ce\u03c3\u03c3\u03b1\u03c2. \u0395\u03c5\u03c6\u03c5\u03b5\u03af\u03c2 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03bf\u03af \u03c0\u03c1\u03ac\u03ba\u03c4\u03bf\u03c1\u03b5\u03c2 \u03ad\u03c7\u03bf\u03c5\u03bd \u03b1\u03bd\u03b1\u03c0\u03c4\u03c5\u03c7\u03b8\u03b5\u03af \u03ba\u03b1\u03b9 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b7\u03b8\u03b5\u03af \u03b5\u03c0\u03b1\u03bd\u03b5\u03b9\u03bb\u03b7\u03bc\u03bc\u03ad\u03bd\u03b1 \u03c9\u03c2 \u03c0\u03b1\u03b9\u03b4\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03ac \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03b1 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03bd\u03af\u03c3\u03c7\u03c5\u03c3\u03b7 \u03c4\u03c9\u03bd \u03ba\u03b9\u03bd\u03ae\u03c4\u03c1\u03c9\u03bd \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7\u03c2, \u03ba\u03b1\u03b8\u03ce\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03b5\u03bc\u03c0\u03bb\u03bf\u03ba\u03ae\u03c2 \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd \u03c3\u03b5 \u03c3\u03c5\u03bd\u03b8\u03ae\u03ba\u03b5\u03c2 \u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03ae\u03c2 \u03b4\u03b9\u03b4\u03b1\u03c3\u03ba\u03b1\u03bb\u03af\u03b1\u03c2. \u0388\u03c1\u03b5\u03c5\u03bd\u03b5\u03c2 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd, \u03b5\u03c0\u03af\u03c3\u03b7\u03c2, \u03c0\u03c9\u03c2 \u03bf\u03b9 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03bf\u03af \u03c0\u03c1\u03ac\u03ba\u03c4\u03bf\u03c1\u03b5\u03c2 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b7\u03b8\u03bf\u03cd\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03c4\u03bf\u03c5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5 \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c4\u03b9\u03ba\u03ae\u03c2 \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7\u03c2 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03b6\u03cc\u03bc\u03b5\u03bd\u03b7\u03c2 \u03b1\u03c0\u03cc \u03c5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ae (\u03a3\u039c\u03a5\u03a5). \u03a5\u03c0\u03cc \u03c4\u03bf \u03c0\u03c1\u03af\u03c3\u03bc\u03b1 \u03c4\u03b7\u03c2 \u03a3\u039c\u03a5\u03a5, \u03b7 \u03b4\u03b9\u03b1\u03c4\u03c1\u03b9\u03b2\u03ae \u03b4\u03b9\u03b5\u03c1\u03b5\u03c5\u03bd\u03ac \u03bc\u03b9\u03b1 \u03bd\u03ad\u03b1 \u03b3\u03b5\u03bd\u03b9\u03ac \u03b5\u03c5\u03ad\u03bb\u03b9\u03ba\u03c4\u03c9\u03bd \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03ce\u03bd \u03c0\u03c1\u03b1\u03ba\u03c4\u03cc\u03c1\u03c9\u03bd, \u03bf\u03b9 \u03bf\u03c0\u03bf\u03af\u03bf\u03b9 \u03c5\u03b9\u03bf\u03b8\u03b5\u03c4\u03bf\u03cd\u03bd \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03b9\u03ba\u03ad\u03c2 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2 \u03c0\u03bf\u03c5 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03b5\u03c6\u03b1\u03c1\u03bc\u03bf\u03c3\u03c4\u03bf\u03cd\u03bd \u03b1\u03bd\u03b5\u03be\u03b1\u03c1\u03c4\u03ae\u03c4\u03c9\u03c2 \u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03bf\u03cd \u03c0\u03b5\u03b4\u03af\u03bf\u03c5 \u03ba\u03b1\u03b9 \u03c0\u03c1\u03bf\u03ad\u03c1\u03c7\u03bf\u03bd\u03c4\u03b1\u03b9 \u03b1\u03c0\u03cc \u03c4\u03bf \u03c0\u03b1\u03b9\u03b4\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03cc \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03bf\u03c5 \u03b1\u03ba\u03b1\u03b4\u03b7\u03bc\u03b1\u03ca\u03ba\u03ac \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03bf\u03cd \u03bb\u03cc\u03b3\u03bf\u03c5 (\u0391\u03a0\u039b). \u039c\u03b5 \u03b2\u03ac\u03c3\u03b7 \u03c4\u03b1 \u03b5\u03c5\u03c1\u03ae\u03bc\u03b1\u03c4\u03b1 \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ce\u03bd \u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03b9\u03ba\u03ac \u03bc\u03b5 \u03c4\u03b1 \u03ba\u03cd\u03c1\u03b9\u03b1 \u03c7\u03b1\u03c1\u03b1\u03ba\u03c4\u03b7\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03ac \u03b5\u03c0\u03bf\u03b9\u03ba\u03bf\u03b4\u03bf\u03bc\u03b7\u03c4\u03b9\u03ba\u03ce\u03bd \u03c3\u03c5\u03b6\u03b7\u03c4\u03ae\u03c3\u03b5\u03c9\u03bd \u03c0\u03bf\u03c5 \u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03bf\u03c5\u03bd \u03c7\u03ce\u03c1\u03b1 \u03c3\u03c4\u03b7\u03bd \u03c4\u03ac\u03be\u03b7, \u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c4\u03bf\u03c5 \u0391\u03a0\u039b \u03b1\u03bd\u03b1\u03b4\u03b5\u03b9\u03ba\u03bd\u03cd\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03c3\u03b5\u03b9\u03c1\u03ac \u03b1\u03c0\u03cc \u03c0\u03b1\u03b9\u03b4\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03ac \u03c9\u03c6\u03ad\u03bb\u03b9\u03bc\u03b5\u03c2 \u03c3\u03c4\u03c1\u03b1\u03c4\u03b7\u03b3\u03b9\u03ba\u03ad\u03c2 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2, \u03bf\u03b9 \u03bf\u03c0\u03bf\u03af\u03b5\u03c2 \u03c0\u03c1\u03bf\u03ac\u03b3\u03bf\u03c5\u03bd \u03c4\u03b7\u03bd \u03b9\u03c3\u03cc\u03c4\u03b9\u03bc\u03b7 \u03ba\u03b1\u03b9 \u03b5\u03c0\u03b1\u03c1\u03ba\u03ae \u03c3\u03c5\u03bc\u03bc\u03b5\u03c4\u03bf\u03c7\u03ae \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd \u03c3\u03b5 \u03c0\u03bf\u03b9\u03ba\u03af\u03bb\u03b5\u03c2 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b2\u03b1\u03b8\u03bc\u03af\u03b4\u03b5\u03c2 \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b8\u03ae\u03ba\u03b5\u03c2. \u03a4\u03ad\u03c4\u03bf\u03b9\u03bf\u03c5 \u03b5\u03af\u03b4\u03bf\u03c5\u03c2 \u03c0\u03b1\u03c1\u03b5\u03bc\u03b2\u03ac\u03c3\u03b5\u03b9\u03c2 \u03b1\u03be\u03b9\u03bf\u03c0\u03bf\u03b9\u03ae\u03b8\u03b7\u03ba\u03b1\u03bd \u03c0\u03c1\u03bf\u03c3\u03c6\u03ac\u03c4\u03c9\u03c2 \u03b3\u03b9\u03b1 \u03c4\u03b7 \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03c3\u03b7 \u03c5\u03c0\u03bf\u03c3\u03c4\u03b7\u03c1\u03b9\u03ba\u03c4\u03b9\u03ba\u03ce\u03bd \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03ce\u03bd \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03ce\u03bd \u03c0\u03c1\u03b1\u03ba\u03c4\u03cc\u03c1\u03c9\u03bd \u03bc\u03b5 \u03c3\u03c4\u03cc\u03c7\u03bf \u03c4\u03b7\u03bd \u03b5\u03ba\u03bc\u03b1\u03af\u03b5\u03c5\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03c5\u03bb\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03bf\u03cd \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd \u03ba\u03b1\u03b9 \u03c4\u03b7\u03bd \u03b4\u03b7\u03bc\u03b9\u03bf\u03c5\u03c1\u03b3\u03af\u03b1 \u03c3\u03c5\u03bd\u03b8\u03b7\u03ba\u03ce\u03bd \u03b3\u03cc\u03bd\u03b9\u03bc\u03bf\u03c5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5, \u03b1\u03bd\u03c4\u03af \u03c4\u03b7\u03c2 \u03c0\u03b1\u03c1\u03bf\u03c7\u03ae\u03c2 \u03b4\u03b9\u03b4\u03b1\u03ba\u03c4\u03b9\u03ba\u03ae\u03c2 \u03b2\u03bf\u03ae\u03b8\u03b5\u03b9\u03b1\u03c2 \u03c3\u03b5 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03b1 \u03bc\u03b1\u03b8\u03b7\u03c3\u03b9\u03b1\u03ba\u03ac \u03b1\u03bd\u03c4\u03b9\u03ba\u03b5\u03af\u03bc\u03b5\u03bd\u03b1. \u039c\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03c3\u03ba\u03cc\u03c0\u03b7\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b1\u03bd\u03bf\u03b9\u03c7\u03c4\u03ce\u03bd \u03b5\u03c1\u03b5\u03c5\u03bd\u03b7\u03c4\u03b9\u03ba\u03ce\u03bd \u03b6\u03b7\u03c4\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03c0\u03bf\u03c5 \u03b1\u03c6\u03bf\u03c1\u03bf\u03cd\u03bd \u03c4\u03b7\u03bd \u03b1\u03c0\u03bf\u03b4\u03bf\u03c4\u03b9\u03ba\u03ae \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03c3\u03b7 \u03ba\u03b1\u03b9 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c0\u03c1\u03b1\u03ba\u03c4\u03cc\u03c1\u03c9\u03bd \u0391\u03a0\u039b, \u03b7 \u03b4\u03b9\u03b1\u03c4\u03c1\u03b9\u03b2\u03ae \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03b6\u03b5\u03b9 \u03ad\u03bd\u03b1 \u03c0\u03c1\u03c9\u03c4\u03cc\u03c4\u03c5\u03c0\u03bf \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03c4\u03c5\u03b1\u03ba\u03cc \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03ce\u03bd \u03c0\u03c1\u03b1\u03ba\u03c4\u03cc\u03c1\u03c9\u03bd \u03c0\u03bf\u03c5 \u03b1\u03bd\u03b1\u03c0\u03c4\u03cd\u03c7\u03b8\u03b7\u03ba\u03b5 \u03c9\u03c2 \u03b5\u03c1\u03b5\u03c5\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc \u03b5\u03c1\u03b3\u03b1\u03bb\u03b5\u03af\u03bf. \u03a4\u03bf \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1, \u03c4\u03bf \u03bf\u03c0\u03bf\u03af\u03bf \u03bf\u03bd\u03bf\u03bc\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 MentorChat, \u03c3\u03c7\u03b5\u03b4\u03b9\u03ac\u03c3\u03c4\u03b7\u03ba\u03b5 \u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c5\u03c0\u03cc\u03c8\u03b7 \u03c4\u03b7\u03bd \u03c3\u03c5\u03bc\u03b2\u03bf\u03bb\u03ae \u03c4\u03c9\u03bd \u03c0\u03b1\u03c1\u03b5\u03bc\u03b2\u03ac\u03c3\u03b5\u03c9\u03bd \u0391\u03a0\u039b \u03c3\u03c4\u03b7\u03bd \u03c0\u03c1\u03bf\u03b1\u03b3\u03c9\u03b3\u03ae \u03b5\u03c5\u03b5\u03c1\u03b3\u03b5\u03c4\u03b9\u03ba\u03ce\u03bd \u03b1\u03bb\u03bb\u03b7\u03bb\u03b5\u03c0\u03b9\u03b4\u03c1\u03ac\u03c3\u03b5\u03c9\u03bd \u03bc\u03b5\u03c4\u03b1\u03be\u03cd \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd, \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03c4\u03bf\u03bd \u03c3\u03b7\u03bc\u03b1\u03bd\u03c4\u03b9\u03ba\u03cc \u03c1\u03cc\u03bb\u03bf \u03c4\u03bf\u03c5 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03bf\u03cd \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03bd\u03bf\u03c1\u03c7\u03ae\u03c3\u03c4\u03c1\u03c9\u03c3\u03b7 \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c4\u03b9\u03ba\u03ae\u03c2 \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7\u03c2. \u03a4\u03bf \u03c3\u03cd\u03c3\u03c4\u03b7\u03bc\u03b1 \u03b1\u03c0\u03bf\u03ba\u03bb\u03af\u03bd\u03b5\u03b9 \u03b1\u03c0\u03cc \u03c4\u03b7\u03bd \u03c0\u03b1\u03c1\u03b1\u03b4\u03bf\u03c3\u03b9\u03b1\u03ba\u03ae \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03c3\u03b7 \u03c3\u03c5\u03c3\u03c4\u03b7\u03bc\u03ac\u03c4\u03c9\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5 \u03c0\u03bf\u03c5 \u03b5\u03c3\u03c4\u03b9\u03ac\u03b6\u03bf\u03c5\u03bd \u03c3\u03c4\u03b7\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03c9\u03bd \u03bc\u03b1\u03b8\u03b7\u03c3\u03b9\u03b1\u03ba\u03ce\u03bd \u03c0\u03bb\u03b7\u03b8\u03c5\u03c3\u03bc\u03ce\u03bd \u03ba\u03b1\u03b9 \u03c0\u03b5\u03b4\u03af\u03c9\u03bd. \u03a3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03b1, \u03c4\u03bf MentorChat \u03b5\u03c0\u03b9\u03c4\u03c1\u03ad\u03c0\u03b5\u03b9 \u03c3\u03c4\u03bf\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03cc \u03bd\u03b1 \u03bf\u03c1\u03b3\u03b1\u03bd\u03ce\u03c3\u03b5\u03b9 \u03bc\u03b9\u03b1 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03c4\u03c5\u03b1\u03ba\u03ae \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c4\u03b9\u03ba\u03ae \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03cc\u03c4\u03b7\u03c4\u03b1, \u03cc\u03c0\u03bf\u03c5 \u03bf\u03b9 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03ba\u03b1\u03bb\u03bf\u03cd\u03bd\u03c4\u03b1\u03b9 \u03bd\u03b1 \u03c3\u03c5\u03b6\u03b7\u03c4\u03ae\u03c3\u03bf\u03c5\u03bd \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b1\u03c0\u03b1\u03bd\u03c4\u03ae\u03c3\u03bf\u03c5\u03bd \u03bf\u03bc\u03b1\u03b4\u03b9\u03ba\u03ac \u03c3\u03b5 \u03bc\u03af\u03b1 \u03c3\u03b5\u03b9\u03c1\u03ac \u03b1\u03c0\u03cc \u03b6\u03b7\u03c4\u03ae\u03bc\u03b1\u03c4\u03b1, \u03ba\u03b1\u03b8\u03ce\u03c2 \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03bf\u03c1\u03af\u03c3\u03b5\u03b9 \u03c4\u03bf \u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03cc \u03bc\u03bf\u03bd\u03c4\u03ad\u03bb\u03bf \u03b5\u03bd\u03cc\u03c2 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03bf\u03cd \u03c0\u03c1\u03ac\u03ba\u03c4\u03bf\u03c1\u03b1, \u03bf \u03bf\u03c0\u03bf\u03af\u03bf\u03c2 \u03b1\u03c0\u03bf\u03b2\u03bb\u03ad\u03c0\u03b5\u03b9 \u03c3\u03c4\u03b7\u03bd \u03c5\u03c0\u03bf\u03b2\u03bf\u03ae\u03b8\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b4\u03b9\u03b1\u03bb\u03cc\u03b3\u03bf\u03c5 \u03c4\u03c9\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03c9\u03bd \u03bc\u03ad\u03c3\u03c9 \u03b4\u03c5\u03bd\u03b1\u03bc\u03b9\u03ba\u03ce\u03bd \u03c0\u03b1\u03c1\u03b5\u03bc\u03b2\u03ac\u03c3\u03b5\u03c9\u03bd \u0391\u03a0\u039b. \u0391\u03be\u03b9\u03bf\u03c0\u03bf\u03b9\u03ce\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf \u03c0\u03b1\u03c1\u03b1\u03bc\u03b5\u03c4\u03c1\u03bf\u03c0\u03bf\u03b9\u03ae\u03c3\u03b9\u03bc\u03bf \u03c0\u03b5\u03c1\u03b9\u03b2\u03ac\u03bb\u03bb\u03bf\u03bd \u03c4\u03bf\u03c5 MentorChat, \u03b7 \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03b7 \u03b4\u03b9\u03b1\u03c4\u03c1\u03b9\u03b2\u03ae \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03b6\u03b5\u03b9 \u03ad\u03be\u03b9 \u03b5\u03c1\u03b5\u03c5\u03bd\u03b7\u03c4\u03b9\u03ba\u03ad\u03c2 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b5\u03c2, \u03bf\u03b9 \u03bf\u03c0\u03bf\u03af\u03b5\u03c2 \u03b4\u03b9\u03b5\u03be\u03ae\u03c7\u03b8\u03b7\u03c3\u03b1\u03bd \u03c3\u03b5 \u03c4\u03ad\u03c3\u03c3\u03b5\u03c1\u03b1 \u03b3\u03bd\u03c9\u03c3\u03c4\u03b9\u03ba\u03ac \u03b1\u03bd\u03c4\u03b9\u03ba\u03b5\u03af\u03bc\u03b5\u03bd\u03b1 (\u0393\u03bb\u03c9\u03c3\u03c3\u03b9\u03ba\u03ae \u0395\u03ba\u03bc\u03ac\u03b8\u03b7\u03c3\u03b7, \u039c\u03ac\u03b8\u03b7\u03c3\u03b7 \u03bc\u03b5 \u03a0\u03bf\u03bb\u03c5\u03bc\u03ad\u03c3\u03b1, \u03a3\u03cd\u03b3\u03c7\u03c1\u03bf\u03bd\u03b7 \u0399\u03c3\u03c4\u03bf\u03c1\u03af\u03b1 \u03ba\u03b1\u03b9 \u0395\u03c0\u03b9\u03ba\u03bf\u03b9\u03bd\u03c9\u03bd\u03af\u03b1 \u0391\u03bd\u03b8\u03c1\u03ce\u03c0\u03bf\u03c5-\u03a5\u03c0\u03bf\u03bb\u03bf\u03b3\u03b9\u03c3\u03c4\u03ae), \u03b4\u03cd\u03bf \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ad\u03c2 \u03b2\u03b1\u03b8\u03bc\u03af\u03b4\u03b5\u03c2 (\u03a0\u03c1\u03c9\u03c4\u03bf\u03b2\u03ac\u03b8\u03bc\u03b9\u03b1 \u03ba\u03b1\u03b9 \u03a4\u03c1\u03b9\u03c4\u03bf\u03b2\u03ac\u03b8\u03bc\u03b9\u03b1 \u0395\u03ba\u03c0\u03b1\u03af\u03b4\u03b5\u03c5\u03c3\u03b7) \u03ba\u03b1\u03b9 \u03b4\u03cd\u03bf \u03b3\u03bb\u03ce\u03c3\u03c3\u03b5\u03c2 (\u0391\u03b3\u03b3\u03bb\u03b9\u03ba\u03ac \u03ba\u03b1\u03b9 \u0395\u03bb\u03bb\u03b7\u03bd\u03b9\u03ba\u03ac). \u039f\u03b9 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b5\u03c2 \u03b1\u03c5\u03c4\u03ad\u03c2 \u03c0\u03b1\u03c1\u03ad\u03c7\u03bf\u03c5\u03bd \u03bc\u03b9\u03b1 \u03b5\u03bc\u03c0\u03b5\u03b9\u03c1\u03b9\u03ba\u03ae \u03b2\u03ac\u03c3\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b1\u03bd\u03ac\u03c0\u03c4\u03c5\u03be\u03b7 \u03bc\u03b9\u03b1\u03c2 \u03b1\u03c5\u03c4\u03bf\u03bc\u03b1\u03c4\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03b7\u03c2, \u03b5\u03c5\u03ad\u03bb\u03b9\u03ba\u03c4\u03b7\u03c2 \u03bc\u03bf\u03c1\u03c6\u03ae\u03c2 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03ae\u03c2 \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7\u03c2, \u03ba\u03b1\u03b9 \u03c3\u03c5\u03bd\u03b5\u03b9\u03c3\u03c6\u03ad\u03c1\u03bf\u03c5\u03bd \u03c3\u03c4\u03b7\u03bd \u03ba\u03b1\u03c4\u03b1\u03bd\u03cc\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c4\u03c1\u03cc\u03c0\u03bf\u03c5 \u03bc\u03b5 \u03c4\u03bf\u03bd \u03bf\u03c0\u03bf\u03af\u03bf \u03c3\u03c5\u03b3\u03ba\u03b5\u03ba\u03c1\u03b9\u03bc\u03ad\u03bd\u03bf\u03b9 \u03bc\u03b7\u03c7\u03b1\u03bd\u03b9\u03c3\u03bc\u03bf\u03af \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2 \u0391\u03a0\u039b \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03bd \u03bd\u03b1 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b7\u03b8\u03bf\u03cd\u03bd \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03b5\u03c3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03c3\u03c4\u03bf \u03c0\u03bb\u03b1\u03af\u03c3\u03b9\u03bf \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c4\u03b9\u03ba\u03ce\u03bd \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03c4\u03b9\u03ba\u03ce\u03bd \u03b4\u03c1\u03b1\u03c3\u03c4\u03b7\u03c1\u03b9\u03bf\u03c4\u03ae\u03c4\u03c9\u03bd \u03b3\u03b9\u03b1 \u03bf\u03bb\u03b9\u03b3\u03bf\u03bc\u03b5\u03bb\u03b5\u03af\u03c2 \u03bf\u03bc\u03ac\u03b4\u03b5\u03c2. \u03a3\u03c5\u03bd\u03bf\u03bb\u03b9\u03ba\u03ac, \u03bf\u03b9 \u03bc\u03b5\u03bb\u03ad\u03c4\u03b5\u03c2 \u03b4\u03b5\u03af\u03c7\u03bd\u03bf\u03c5\u03bd \u03cc\u03c4\u03b9 \u03b7 \u03c7\u03c1\u03ae\u03c3\u03b7 \u03c0\u03c1\u03b1\u03ba\u03c4\u03cc\u03c1\u03c9\u03bd \u0391\u03a0\u039b \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b5\u03af\u03bd\u03b1\u03b9 \u03c0\u03b1\u03b9\u03b4\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03ac \u03c9\u03c6\u03ad\u03bb\u03b9\u03bc\u03b7 \u03c4\u03cc\u03c3\u03bf \u03c3\u03b5 \u03b1\u03c4\u03bf\u03bc\u03b9\u03ba\u03cc \u03cc\u03c3\u03bf \u03ba\u03b1\u03b9 \u03c3\u03b5 \u03bf\u03bc\u03b1\u03b4\u03b9\u03ba\u03cc \u03b5\u03c0\u03af\u03c0\u03b5\u03b4\u03bf, \u03b5\u03bd\u03b8\u03b1\u03c1\u03c1\u03cd\u03bd\u03bf\u03bd\u03c4\u03b1\u03c2 \u03c4\u03bf\u03c5\u03c2 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03c5\u03c2 \u03bd\u03b1 \u03b5\u03ba\u03c6\u03c1\u03ac\u03c3\u03bf\u03c5\u03bd \u03bc\u03b5 \u03c3\u03b1\u03c6\u03ae\u03bd\u03b5\u03b9\u03b1 \u03c4\u03bf \u03c3\u03c5\u03bb\u03bb\u03bf\u03b3\u03b9\u03c3\u03bc\u03cc \u03c4\u03bf\u03c5\u03c2, \u03b1\u03bb\u03bb\u03ac \u03ba\u03b1\u03b9 \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c4\u03b7\u03c1\u03ae\u03c3\u03bf\u03c5\u03bd \u03ad\u03bd\u03b1 \u03c0\u03b1\u03c1\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03cc \u03b4\u03b9\u03ac\u03bb\u03bf\u03b3\u03bf \u03bc\u03b5\u03c4\u03b1\u03be\u03cd \u03c4\u03bf\u03c5\u03c2. \u0395\u03c0\u03b9\u03c0\u03bb\u03ad\u03bf\u03bd, \u03bf\u03b9 \u03b5\u03ba\u03c0\u03b1\u03b9\u03b4\u03b5\u03c5\u03cc\u03bc\u03b5\u03bd\u03bf\u03b9 \u03b5\u03ba\u03bb\u03b1\u03bc\u03b2\u03ac\u03bd\u03bf\u03c5\u03bd \u03b8\u03b5\u03c4\u03b9\u03ba\u03ac \u03c4\u03b9\u03c2 \u03c0\u03b1\u03c1\u03b5\u03bc\u03b2\u03ac\u03c3\u03b5\u03b9\u03c2 \u03c4\u03bf\u03c5 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03bf\u03cd \u03c0\u03c1\u03ac\u03ba\u03c4\u03bf\u03c1\u03b1, \u03b8\u03b5\u03c9\u03c1\u03ce\u03bd\u03c4\u03b1\u03c2 \u03cc\u03c4\u03b9 \u03b4\u03b9\u03b5\u03c5\u03ba\u03bf\u03bb\u03cd\u03bd\u03bf\u03c5\u03bd \u03c4\u03b7 \u03c3\u03c5\u03b6\u03ae\u03c4\u03b7\u03c3\u03b7 \u03c4\u03b7\u03c2 \u03bf\u03bc\u03ac\u03b4\u03b1\u03c2. \u03a4\u03ad\u03bb\u03bf\u03c2, \u03c0\u03b1\u03c1\u03bf\u03c5\u03c3\u03b9\u03ac\u03b6\u03b5\u03c4\u03b1\u03b9 \u03c0\u03ce\u03c2 \u03b7 \u03bf\u03c1\u03b8\u03ae \u03c3\u03c7\u03b5\u03b4\u03af\u03b1\u03c3\u03b7 \u03bf\u03c1\u03b9\u03c3\u03bc\u03ad\u03bd\u03c9\u03bd \u03bc\u03b5\u03b8\u03cc\u03b4\u03c9\u03bd \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03ae\u03c2 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b2\u03b1\u03c3\u03b7\u03c2 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b2\u03b5\u03bb\u03c4\u03b9\u03ce\u03c3\u03b5\u03b9 \u03b4\u03c1\u03b1\u03c3\u03c4\u03b9\u03ba\u03ac \u03c4\u03b7\u03bd \u03c0\u03b1\u03b9\u03b4\u03b1\u03b3\u03c9\u03b3\u03b9\u03ba\u03ae \u03b1\u03be\u03af\u03b1 \u03b5\u03bd\u03cc\u03c2 \u03b4\u03b9\u03b1\u03bb\u03bf\u03b3\u03b9\u03ba\u03bf\u03cd \u03c0\u03c1\u03ac\u03ba\u03c4\u03bf\u03c1\u03b1 \u03c3\u03c4\u03b7\u03bd \u03c5\u03c0\u03bf\u03c3\u03c4\u03ae\u03c1\u03b9\u03be\u03b7 \u03c4\u03b7\u03c2 \u03c3\u03c5\u03bd\u03b5\u03c1\u03b3\u03b1\u03c4\u03b9\u03ba\u03ae\u03c2 \u03bc\u03ac\u03b8\u03b7\u03c3\u03b7\u03c2.</jats:p>", "DOI": "10.12681/eadd/38148", "type": "dissertation", "created": {"date-parts": [[2021, 9, 6]], "date-time": "2021-09-06T11:13:42Z", "timestamp": 1630926822000}, "approved": {"date-parts": [[2