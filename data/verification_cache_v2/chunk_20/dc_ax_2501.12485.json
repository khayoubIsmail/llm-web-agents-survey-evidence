{"data": {"id": "10.48550/arxiv.2501.12485", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2501.12485", "prefix": "10.48550", "suffix": "arxiv.2501.12485", "identifiers": [{"identifier": "2501.12485", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2501.12485"}], "creators": [{"name": "Huang, Tenghao", "nameType": "Personal", "givenName": "Tenghao", "familyName": "Huang", "affiliation": [], "nameIdentifiers": []}, {"name": "Basu, Kinjal", "nameType": "Personal", "givenName": "Kinjal", "familyName": "Basu", "affiliation": [], "nameIdentifiers": []}, {"name": "Abdelaziz, Ibrahim", "nameType": "Personal", "givenName": "Ibrahim", "familyName": "Abdelaziz", "affiliation": [], "nameIdentifiers": []}, {"name": "Kapanipathi, Pavan", "nameType": "Personal", "givenName": "Pavan", "familyName": "Kapanipathi", "affiliation": [], "nameIdentifiers": []}, {"name": "May, Jonathan", "nameType": "Personal", "givenName": "Jonathan", "familyName": "May", "affiliation": [], "nameIdentifiers": []}, {"name": "Chen, Muhao", "nameType": "Personal", "givenName": "Muhao", "familyName": "Chen", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "R2D2: Remembering, Replaying and Dynamic Decision Making with a Reflective Agentic Memory"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-01-21T20:21:58Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-01-23T01:04:01Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-06-07T05:48:21Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2025-06-10T00:23:06Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2025-07-22T04:14:16Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2025-07-23T00:17:56Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2025-01", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "3", "rightsList": [{"rights": "Creative Commons Attribution 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "The proliferation of web agents necessitates advanced navigation and interaction strategies within complex web environments. Current models often struggle with efficient navigation and action execution due to limited visibility and understanding of web structures. Our proposed R2D2 framework addresses these challenges by integrating two paradigms: Remember and Reflect. The Remember paradigm uses a replay buffer that aids agents in reconstructing the web environment dynamically, thus enabling the formulation of a detailed \"map\" of previously visited pages. This helps in reducing navigational errors and optimizing the decision-making process during web interactions. Conversely, the Reflect paradigm allows agents to learn from past mistakes by providing a mechanism for error analysis and strategy refinement, enhancing overall task performance. We evaluate R2D2 using the WebArena benchmark, demonstrating substantial improvements over existing methods, including a 50% reduction in navigation errors and a threefold increase in task completion rates. Our findings suggest that a combination of memory-enhanced navigation and reflective learning promisingly advances the capabilities of web agents, potentially benefiting various applications such as automated customer service and personal digital assistants.", "descriptionType": "Abstract"}, {"description": "ACL 2025", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2501.12485", "contentUrl": null, "metadataVersion": 2, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-01-23T02:32:15.000Z", "registered": "2025-01-23T02:32:16.000Z", "published": "2025", "updated": "2025-07-23T02:05:16.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2501.12485", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}