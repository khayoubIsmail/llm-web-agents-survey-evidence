://pubs.acs.org/doi/suppl/10.1021/acsami.2c17112/suppl_file/am2c17112_si_002.mp4"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.1021/acsami.2c17112.s002", "relation": {"is-component-of": [{"id-type": "doi", "id": "10.1021/acsami.2c17112", "asserted-by": "object"}]}}, {"indexed": {"date-parts": [[2026, 2, 26]], "date-time": "2026-02-26T16:21:59Z", "timestamp": 1772122919517, "version": "3.50.1"}, "description": "Supplemental Information for 10.1021/acsami.2c17112", "reference-count": 0, "publisher": "American Chemical Society (ACS)", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.1021/acsami.2c17112.s003", "type": "component", "created": {"date-parts": [[2022, 12, 1]], "date-time": "2022-12-01T10:40:45Z", "timestamp": 1669891245000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Construction of Self-Supporting NiCoFe Nanotube Arrays Enabling High-Efficiency Alkaline Oxygen Evolution"], "prefix": "10.1021", "member": "316", "deposited": {"date-parts": [[2022, 12, 14]], "date-time": "2022-12-14T04:54:57Z", "timestamp": 1670993697000}, "score": 23.745333, "resource": {"primary": {"URL": "https://pubs.acs.org/doi/suppl/10.1021/acsami.2c17112/suppl_file/am2c17112_si_003.mp4"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.1021/acsami.2c17112.s003", "relation": {"is-component-of": [{"id-type": "doi", "id": "10.1021/acsami.2c17112", "asserted-by": "object"}]}}, {"indexed": {"date-parts": [[2024, 9, 7]], "date-time": "2024-09-07T20:05:09Z", "timestamp": 1725739509722}, "publisher-location": "Berkeley, CA", "reference-count": 0, "publisher": "Apress", "isbn-type": [{"type": "print", "value": "9781893115736"}, {"type": "electronic", "value": "9781430208501"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2002]]}, "DOI": "10.1007/978-1-4302-0850-1_3", "type": "book-chapter", "created": {"date-parts": [[2013, 7, 5]], "date-time": "2013-07-05T08:29:27Z", "timestamp": 1373012967000}, "page": "15-22", "source": "Crossref", "is-referenced-by-count": 1, "title": ["The Evolution of Web Application Architectures"], "prefix": "10.1007", "author": [{"given": "Ken", "family": "Abbott", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "297", "container-title": ["Voice Enabling Web Applications: VoiceXML and Beyond"], "language": "en", "link": [{"URL": "http://link.springer.com/content/pdf/10.1007/978-1-4302-0850-1_3", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2013, 7, 5]], "date-time": "2013-07-05T08:29:32Z", "timestamp": 1373012972000}, "score": 22.292866, "resource": {"primary": {"URL": "http://link.springer.com/10.1007/978-1-4302-0850-1_3"}}, "issued": {"date-parts": [[2002]]}, "ISBN": ["9781893115736", "9781430208501"], "references-count": 0, "URL": "https://doi.org/10.1007/978-1-4302-0850-1_3", "published": {"date-parts": [[2002]]}}, {"indexed": {"date-parts": [[2026, 5, 29]], "date-time": "2026-05-29T15:07:38Z", "timestamp": 1780067258131, "version": "3.54.0"}, "posted": {"date-parts": [[2026]]}, "group-title": "SSRN", "reference-count": 0, "publisher": "Elsevier BV", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Large language model (LLM)-based agents are increasingly being explored for healthcare tasks such as clinical decision support, care coordination and autonomous workflow execution. Beyond static pipelines, recent systems claim to self-evolve by adapting their tools, memory, reasoning, policy, context and coordination strategies over time. However, what constitutes true self-evolution in healthcare agents remains unclear and is inconsistently evaluated. In this work, we introduce a six-dimensional taxonomy to rigorously characterize self-evolving LLM agents in healthcare, comprising Tools &amp;amp; Capabilities, Memory &amp;amp; Knowledge, Context &amp;amp; Prompt, Policy &amp;amp; Strategy, Multi-Agent Coordination and Reasoning. Using this taxonomy, we systematically evaluate 18 representative healthcare agent papers under strict mechanism-level criteria that separate genuine selfevolution from surface-level performance improvements. Our results reveal that memory evolution is the most common capability with over half of the surveyed systems exhibiting reflective or distilled memory growth, while only 5.6% demonstrates memory refactoring. In contrast, prompt self-revision appears in 33.3% of the papers and tool-selection evolution appears in only 5.6%. Multi-agent architectures (i.e., systems with multiple interacting agent roles/modules) are frequent, yet learned coordination remains limited, with only 16.7% exhibiting evolving protocols or topologies. We find no evidence of formal policy optimization or reasoning-mechanism evolution across these 18 papers. Overall, our analysis shows a clear gap between claimed adaptivity and verifiable self-evolution in current healthcare agents. This taxonomy provides a principled foundation for evaluating future self-evolving LLM systems and supports more rigorous, reproducible progress toward adaptive clinical AI.</jats:p>", "DOI": "10.2139/ssrn.6796558", "type": "posted-content", "created": {"date-parts": [[2026, 5, 29]], "date-time": "2026-05-29T14:58:24Z", "timestamp": 1780066704000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Beyond Static Agents: A Six-Dimensional Taxonomy and Survey of Self-Evolving LLM Agents for Healthcare"], "prefix": "10.2139", "author": [{"ORCID": "https://orcid.org/0009-0002-6435-1988", "authenticated-orcid": true, "given": "Shubham", "family": "Vatsal", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Ahsaas", "family": "Bajaj", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"ORCID": "https://orcid.org/0009-0000-4078-7491", "authenticated-orcid": true, "given": "Harsh", "family": "Dubey", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "78", "deposited": {"date-parts": [[2026, 5, 29]], "date-time": "2026-05-29T14:58:24Z", "timestamp": 1780066704000}, "score": 21.543804, "resource": {"primary": {"URL": "https://www.ssrn.com/abstract=6796558"}}, "issued": {"date-parts": [[2026]]}, "references-count": 0, "URL": "https://doi.org/10.2139/ssrn.6796558", "published": {"date-parts": [[2026]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2025, 10, 24]], "date-time": "2025-10-24T22:02:09Z", "timestamp": 1761343329394, "version": "build-2065373602"}, "reference-count": 0, "publisher": "Princeton University Press", "isbn-type": [{"type": "electronic", "value": "9780691226224"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2023, 10, 3]]}, "DOI": "10.2307/jj.1895842.9", "type": "book-chapter", "created": {"date-parts": [[2023, 10, 3]], "date-time": "2023-10-03T10:20:11Z", "timestamp": 1696328411000}, "page": "95-120", "source": "Crossref", "is-referenced-by-count": 0, "title": ["The Perceiving Self"], "prefix": "10.2307", "member": "1121", "container-title": ["Free Agents"], "deposited": {"date-parts": [[2025, 10, 24]], "date-time": "2025-10-24T21:57:43Z", "timestamp": 1761343063000}, "score": 21.023172, "resource": {"primary": {"URL": "http://www.jstor.org/stable/10.2307/jj.1895842.9"}}, "issued": {"date-parts": [[2023, 10, 3]]}, "ISBN": ["9780691226224"], "references-count": 0, "URL": "https://doi.org/10.2307/jj.1895842.9", "published": {"date-parts": [[2023, 10, 3]]}}, {"indexed": {"date-parts": [[2026, 4, 9]], "date-time": "2026-04-09T04:43:58Z", "timestamp": 1775709838414, "version": "3.50.1"}, "posted": {"date-parts": [[2026]]}, "group-title": "SSRN", "reference-count": 0, "publisher": "Elsevier BV", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>The dominant paradigm for integrating Large Language Models (LLMs) into Security Operations Centers (SOCs), which this paper terms prescribed intelligence (human-engineered skills, hardcoded tool integrations, and prompt templates), is structurally insufficient for replicating the adaptive workflows of expert SOC analysts. This paper identifies five limitations of that paradigm and proposes credentialed self-exploration as an alternative: provision an LLM agent with strictly read-only access to a sandboxed or test SOC environment, describe its role, and let it autonomously discover data sources, learn tool relationships, and propose executable skills for human review. During exploration, the agent takes no action on production systems; only skills that pass human review are deployed. The paper introduces AESOP (Agent-driven Exploration for Security Operations Proficiency), a conceptual framework for this self-directed architecture, and outlines a research agenda for empirical validation. Supporting evidence draws on cross-domain advances in tool learning, autonomous agents, and offensive security (penetration testing), demonstrating patterns transferable to defensive SOC operations-a central question this work raises.</jats:p>", "DOI": "10.2139/ssrn.6438922", "type": "posted-content", "created": {"date-parts": [[2026, 4, 9]], "date-time": "2026-04-09T03:47:41Z", "timestamp": 1775706461000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Beyond Prescribed Intelligence: Toward Self-Directed Skill Acquisition in LLM-Based Cybersecurity Agents"], "prefix": "10.2139", "author": [{"ORCID": "https://orcid.org/0009-0004-3762-9408", "authenticated-orcid": true, "given": "Mika D", "family": "Ayenson", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "78", "deposited": {"date-parts": [[2026, 4, 9]], "date-time": "2026-04-09T03:47:41Z", "timestamp": 1775706461000}, "score": 21.017126, "resource": {"primary": {"URL": "https://www.ssrn.com/abstract=6438922"}}, "issued": {"date-parts": [[2026]]}, "references-count": 0, "URL": "https://doi.org/10.2139/ssrn.6438922", "published": {"date-parts": [[2026]]}, "subtype": "preprint"}], "items-per-page": 10, "query": {"start-index": 0, "search-terms": null}}}