{"data": {"id": "10.48550/arxiv.2509.26506", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2509.26506", "prefix": "10.48550", "suffix": "arxiv.2509.26506", "identifiers": [{"identifier": "2509.26506", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2509.26506"}], "creators": [{"name": "Dai, Yutong", "nameType": "Personal", "givenName": "Yutong", "familyName": "Dai", "affiliation": [], "nameIdentifiers": []}, {"name": "Ramakrishnan, Krithika", "nameType": "Personal", "givenName": "Krithika", "familyName": "Ramakrishnan", "affiliation": [], "nameIdentifiers": []}, {"name": "Gu, Jing", "nameType": "Personal", "givenName": "Jing", "familyName": "Gu", "affiliation": [], "nameIdentifiers": []}, {"name": "Fernandez, Matthew", "nameType": "Personal", "givenName": "Matthew", "familyName": "Fernandez", "affiliation": [], "nameIdentifiers": []}, {"name": "Luo, Yanqi", "nameType": "Personal", "givenName": "Yanqi", "familyName": "Luo", "affiliation": [], "nameIdentifiers": []}, {"name": "Prabhu, Viraj", "nameType": "Personal", "givenName": "Viraj", "familyName": "Prabhu", "affiliation": [], "nameIdentifiers": []}, {"name": "Hu, Zhenyu", "nameType": "Personal", "givenName": "Zhenyu", "familyName": "Hu", "affiliation": [], "nameIdentifiers": []}, {"name": "Savarese, Silvio", "nameType": "Personal", "givenName": "Silvio", "familyName": "Savarese", "affiliation": [], "nameIdentifiers": []}, {"name": "Xiong, Caiming", "nameType": "Personal", "givenName": "Caiming", "familyName": "Xiong", "affiliation": [], "nameIdentifiers": []}, {"name": "Chen, Zeyuan", "nameType": "Personal", "givenName": "Zeyuan", "familyName": "Chen", "affiliation": [], "nameIdentifiers": []}, {"name": "Xu, Ran", "nameType": "Personal", "givenName": "Ran", "familyName": "Xu", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "SCUBA: Salesforce Computer Use Benchmark"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-09-30T16:48:49Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-10-01T01:17:00Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-09", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "1", "rightsList": [{"rights": "Creative Commons Attribution 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "We introduce SCUBA, a benchmark designed to evaluate computer-use agents on customer relationship management (CRM) workflows within the Salesforce platform. SCUBA contains 300 task instances derived from real user interviews, spanning three primary personas, platform administrators, sales representatives, and service agents. The tasks test a range of enterprise-critical abilities, including Enterprise Software UI navigation, data manipulation, workflow automation, information retrieval, and troubleshooting. To ensure realism, SCUBA operates in Salesforce sandbox environments with support for parallel execution and fine-grained evaluation metrics to capture milestone progress. We benchmark a diverse set of agents under both zero-shot and demonstration-augmented settings. We observed huge performance gaps in different agent design paradigms and gaps between the open-source model and the closed-source model. In the zero-shot setting, open-source model powered computer-use agents that have strong performance on related benchmarks like OSWorld only have less than 5\\% success rate on SCUBA, while methods built on closed-source models can still have up to 39% task success rate. In the demonstration-augmented settings, task success rates can be improved to 50\\% while simultaneously reducing time and costs by 13% and 16%, respectively. These findings highlight both the challenges of enterprise tasks automation and the promise of agentic solutions. By offering a realistic benchmark with interpretable evaluation, SCUBA aims to accelerate progress in building reliable computer-use agents for complex business software ecosystems.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2509.26506", "contentUrl": null, "metadataVersion": 0, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-10-01T02:38:39.000Z", "registered": "2025-10-01T02:38:40.000Z", "published": "2025", "updated": "2025-10-01T02:38:40.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2509.26506", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}