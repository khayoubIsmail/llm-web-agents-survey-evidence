19]]}, "DOI": "10.1201/b12118-14", "type": "book-chapter", "created": {"date-parts": [[2012, 5, 14]], "date-time": "2012-05-14T17:39:46Z", "timestamp": 1337017186000}, "page": "289-318", "source": "Crossref", "is-referenced-by-count": 0, "title": ["- Agent-based web"], "prefix": "10.1201", "member": "301", "reference": [{"key": "ref11", "unstructured": "Harrison, C. G., Chess, D. M., and Kershenbaum, A. 1995. Mobile agents: Are they a good idea? IBM Research Report, IBM Research Division, Yorktown Heights, NY."}], "container-title": ["Intelligent Technologies for Web Applications"], "language": "en", "deposited": {"date-parts": [[2020, 12, 22]], "date-time": "2020-12-22T14:39:01Z", "timestamp": 1608647941000}, "score": 28.774784, "resource": {"primary": {"URL": "https://www.taylorfrancis.com/books/9781439871645/chapters/10.1201/b12118-14"}}, "issued": {"date-parts": [[2016, 4, 19]]}, "ISBN": ["9780429065965"], "references-count": 1, "URL": "https://doi.org/10.1201/b12118-14", "published": {"date-parts": [[2016, 4, 19]]}}, {"indexed": {"date-parts": [[2026, 6, 10]], "date-time": "2026-06-10T16:04:20Z", "timestamp": 1781107460622, "version": "3.54.1"}, "reference-count": 0, "publisher": "IGI Global", "isbn-type": [{"value": "9781615209637", "type": "print"}, {"value": "9781615209644", "type": "electronic"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2010]]}, "abstract": "<jats:p>eLearning is often conceived as a single product. In reality however the market offering is very heterogeneous with a large product variety. Think of Learning Management Systems, Virtual Classrooms, Authorware, Test &amp; Assessment Tools, Simulators and many more. And each of these eLearning applications is available from multiple vendors and middlemen. Next to more than 250 providers of commercial Learning Management Systems, more than 40\u00a0Open\u00a0Source\u00a0LMS offerings can be identified. In this paper I discuss if today\u00a0open\u00a0source\u00a0applications\u00a0foreLearning offer an alternative to commercial offerings, specifically in the context of Education. The lessons drawn here also apply to other (public) organisations and applications.</jats:p>", "DOI": "10.4018/978-1-61520-963-7.ch043", "type": "book-chapter", "created": {"date-parts": [[2011, 5, 24]], "date-time": "2011-05-24T14:12:10Z", "timestamp": 1306246330000}, "page": "633-642", "source": "Crossref", "is-referenced-by-count": 0, "title": ["Opportunities for Open Source E-Learning"], "prefix": "10.4018", "author": [{"given": "Fanuel", "family": "Dewever", "sequence": "first", "affiliation": [{"name": "IBM, Belgium"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "2432", "container-title": ["Web-Based Education"], "link": [{"URL": "https://www.igi-global.com/viewtitle.aspx?TitleId=41369", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2019, 2, 18]], "date-time": "2019-02-18T17:07:29Z", "timestamp": 1550509649000}, "score": 28.6622, "resource": {"primary": {"URL": "http://services.igi-global.com/resolvedoi/resolve.aspx?doi=10.4018/978-1-61520-963-7.ch043"}}, "subtitle": [""], "issued": {"date-parts": [[2010]]}, "ISBN": ["9781615209637", "9781615209644"], "references-count": 0, "aliases": ["10.4018/9781615209637.ch043"], "URL": "https://doi.org/10.4018/978-1-61520-963-7.ch043", "published": {"date-parts": [[2010]]}}, {"indexed": {"date-parts": [[2026, 6, 10]], "date-time": "2026-06-10T16:23:25Z", "timestamp": 1781108605388, "version": "3.54.1"}, "reference-count": 0, "publisher": "IGI Global", "isbn-type": [{"value": "9781599045252", "type": "print"}, {"value": "9781599045276", "type": "electronic"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>eLearning is often conceived as a single product. In reality however the market offering is very heterogeneous with a large product variety. Think of Learning Management Systems, Virtual Classrooms, Authorware, Test &amp; Assessment Tools, Simulators and many more. And each of these eLearning applications is available from multiple vendors and middlemen. Next to more than 250 providers of commercial Learning Management Systems, more than 40 Open Source LMS offerings can be identified. In this paper I discuss if today open source applications for eLearning offer an alternative to commercial offerings, specifically in the context of Education. The lessons drawn here also apply to other (public) organisations and applications.</jats:p>", "DOI": "10.4018/978-1-59904-525-2.ch014", "type": "book-chapter", "created": {"date-parts": [[2010, 5, 25]], "date-time": "2010-05-25T21:42:47Z", "timestamp": 1274823767000}, "page": "252-265", "source": "Crossref", "is-referenced-by-count": 1, "title": ["Opportunities for Open Source E-Learning"], "prefix": "10.4018", "author": [{"given": "Fanuel", "family": "Dewever", "sequence": "first", "affiliation": [{"name": "IBM, Belgium"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "2432", "container-title": ["Web-Based Education and Pedagogical Technologies"], "link": [{"URL": "https://www.igi-global.com/viewtitle.aspx?TitleId=31287", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2018, 11, 19]], "date-time": "2018-11-19T13:24:24Z", "timestamp": 1542633864000}, "score": 28.253725, "resource": {"primary": {"URL": "http://services.igi-global.com/resolvedoi/resolve.aspx?doi=10.4018/978-1-59904-525-2.ch014"}}, "subtitle": [""], "issued": {"date-parts": [[null]]}, "ISBN": ["9781599045252", "9781599045276"], "references-count": 0, "URL": "https://doi.org/10.4018/978-1-59904-525-2.ch014"}, {"indexed": {"date-parts": [[2024, 9, 8]], "date-time": "2024-09-08T06:50:54Z", "timestamp": 1725778254898}, "reference-count": 12, "publisher": "IEEE", "content-domain": {