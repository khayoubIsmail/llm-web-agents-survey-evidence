{"data": {"id": "10.48550/arxiv.2603.04949", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2603.04949", "prefix": "10.48550", "suffix": "arxiv.2603.04949", "identifiers": [{"identifier": "2603.04949", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2603.04949"}], "creators": [{"name": "Ishmam, Md Farhan", "nameType": "Personal", "givenName": "Md Farhan", "familyName": "Ishmam", "affiliation": [], "nameIdentifiers": []}, {"name": "Marino, Kenneth", "nameType": "Personal", "givenName": "Kenneth", "familyName": "Marino", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "TimeWarp: Evaluating Web Agents by Revisiting the Past"}], "publisher": "arXiv", "container": {}, "publicationYear": 2026, "subjects": [{"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Computer Vision and Pattern Recognition (cs.CV)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Machine Learning (cs.LG)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2026-03-05T08:43:06Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2026-03-06T01:41:23Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2026-09-08T06:29:33Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2026-09-09T02:21:24Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2026-03", "dateType": "Available", "dateInformation": "v1"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rights": "Creative Commons Attribution 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "As web agents close the gap with humans on benchmarks, one question arises: Do today's agents perform just as well on tomorrow's web? We introduce TimeWarp, a benchmark that emulates the evolving web. TimeWarp consists of three web environments, each with six UI versions spanning UI design, frontend code, and workflows from different eras of the internet. We pair TimeWarp with a set of complex, realistic tasks covering different forms of web navigation. Our experiments reveal that vision-based agents are vulnerable to changes, while text-based agents become brittle once fine-tuned on a single version. To address this, we propose TimeTraj, a new annotation method that uses plan distillation to collect trajectories across multiple versions. By training agents on teacher rollouts using our BC-variant, we achieve substantial performance gains: 20.4% to 37.7% for Qwen-3 4B and 0% to 27.0% for Llama-3.1 8B models. Our work helps study generalization across web designs and opens a new paradigm for collecting plans rather than trajectories to improve the robustness of web agents.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2603.04949", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2026-03-06T03:05:03.000Z", "registered": "2026-03-06T03:05:03.000Z", "published": "2026", "updated": "2026-09-09T06:00:11.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2603.04949", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}