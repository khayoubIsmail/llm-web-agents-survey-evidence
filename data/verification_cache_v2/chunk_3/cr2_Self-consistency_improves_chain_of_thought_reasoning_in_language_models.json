: {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>&lt;strong&gt; Introduction &lt;/strong&gt; Large language models (LLMs) like ChatGPT have transformed how we use artificial intelligence, excelling at tasks like writing essays, answering questions, and even holding conversations. But when it comes to complex reasoning\u2014think solving math problems, tackling commonsense puzzles, or working with symbols\u2014these models often hit a wall.</jats:p>", "DOI": "10.59350/bkm9q-11k47", "type": "posted-content", "created": {"date-parts": [[2025, 4, 29]], "date-time": "2025-04-29T11:02:31Z", "timestamp": 1745924551000}, "source": "Crossref", "is-referenced-by-count": 2, "title": ["Active Prompting with Chain-of-Thought: Revolutionising Reasoning in Large Language Models"], "prefix": "10.59350", "author": [{"ORCID": "https://orcid.org/0009-0009-3354-7794", "authenticated-orcid": false, "given": "Immanuel Alvaro", "family": "Bhirawa", "sequence": "first", "affiliation": [{"id": [{"id": "https://ror.org/019wvm592", "id-type": "ROR", "asserted-by": "publisher"}], "name": "Australian National University"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "31795", "reference": [{"key": "ref1", "doi-asserted-by": "publisher", "unstructured": "Diao, S., Wang, P., Lin, Y., Pan, R., Liu, X., & Zhang, T. (2023). Active Prompting with Chain-of-Thought for Large Language Models (Version 5). arXiv.", "DOI": "10.48550/arxiv.2302.12246"}, {"key": "ref2", "doi-asserted-by": "publisher", "unstructured": "Wei, J., Wang, X., Schuurmans, D., Bosma, M., Ichter, B., Xia, F., Chi, E., Le, Q., & Zhou, D. (2022). Chain-of-Thought Prompting Elicits Reasoning in Large Language Models (Version 6). arXiv.", "DOI": "10.48550/arxiv.2201.11903"}, {"key": "ref3", "doi-asserted-by": "publisher", "unstructured": "Wang, X., Wei, J., Schuurmans, D., Le, Q., Chi, E., Narang, S., Chowdhery, A., & Zhou, D. (2022). Self-Consistency Improves Chain of Thought Reasoning in La