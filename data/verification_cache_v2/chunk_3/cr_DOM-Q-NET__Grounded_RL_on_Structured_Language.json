rts": [[2025, 10, 26]], "date-time": "2025-10-26T10:20:30Z", "timestamp": 1761474030000}, "score": 25.783365, "resource": {"primary": {"URL": "https://www.scitepress.org/DigitalLibrary/Link.aspx?doi=10.5220/0013864400003985"}}, "subtitle": [""], "issued": {"date-parts": [[2025]]}, "references-count": 0, "URL": "https://doi.org/10.5220/0013864400003985", "published": {"date-parts": [[2025]]}}, {"indexed": {"date-parts": [[2024, 8, 7]], "date-time": "2024-08-07T13:37:09Z", "timestamp": 1723037829864}, "reference-count": 0, "publisher": "Institute of Russian Literature Pushkinskij Dom RAN", "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["RL"], "published-print": {"date-parts": [[2021]]}, "abstract": "<jats:p>Review: Vja\u010deslav Ivanov und seine deutschsprachigen Verleger / Hrsg. von Michael Wachtel und Philip Gleissner; unter Mitwirkung von Vladimir Janzen. Berlin; Bern; Bruxelles; New York; Oxford; Warszawa; Wien: Peter Lang, 2019. 374 S., 22 Abb. (Russian Culture in Europe; vol. 14).</jats:p>", "DOI": "10.31860/0131-6095-2021-2-257-259", "type": "journal-article", "created": {"date-parts": [[2021, 9, 22]], "date-time": "2021-09-22T20:49:54Z", "timestamp": 1632343794000}, "page": "257-259", "source": "Crossref", "is-referenced-by-count": 0, "title": ["VYACHESLAV IVANOV AND HIS GERMAN-LANGUAGE PUBLISHERS"], "prefix": "10.31860", "volume": "2", "author": [{"name": "Institute of Russian Literature (Pushkinskij Dom), Russian Academy of Sciences", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Konstantin Iur\u2019evich", "family": "Lappo-Danilevskii", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "17115", "published-online": {"date-parts": [[2021]]}, "container-title": ["Russkaya literatura"], "original-title": ["Institute of Russian Literature (Pushkinskij Dom), Russian Academy of Sciences"], "deposited": {"date-parts": [[2021, 9, 22]], "date-time": "2021-09-22T20:49:58Z", "timestamp": 1632343798000}, "score": 25.635841, "resource": {"primary": {"URL": "http://pushkinskijdom.ru/wp-content/uploads/2021/05/29_Lappo-Danilevskij.pdf"}}, "issued": {"date-parts": [[2021]]}, "references-count": 0, "URL": "https://doi.org/10.31860/0131-6095-2021-2-257-259", "ISSN": ["0131-6095"], "issn-type": [{"type": "print", "value": "0131-6095"}], "published": {"date-parts": [[2021]]}}, {"indexed": {"date-parts": [[2026, 8, 27]], "date-time": "2026-08-27T16:25:27Z", "timestamp": 1787847927494, "version": "build-2784847793"}, "posted": {"date-parts": [[2026, 8, 27]]}, "group-title": "Immunology and Infectious Disease", "reference-count": 0, "publisher": "California Digital Library (CDL)", "license": [{"start": {"date-parts": [[2026, 8, 27]], "date-time": "2026-08-27T00:00:00Z", "timestamp": 1787788800000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0/legalcode"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "accepted": {"date-parts": [[2026, 8, 27]]}, "abstract": "<jats:p>The net reproductive rate, or per-generation population growth rate R0, is a key concept for population and epidemic dynamics, because persistence versus extinction is often determined by the sign of R0\u22121. Because it is defined as generation-to-generation growth, it is hard to assess empirically for structured populations or epidemics where generations overlap, and is usually estimated by parameterising dynamic models. Here we introduce the Cohort Net Reproductive Rate R0 (c) \u2013 the average per-capita number of offspring or secondary infections produced by individuals born or infected at the same time. We derive a general formula for R0(c) , show that it obeys the same invasion threshold as R0, and analyze when the two coincide or diverge. R0(c) can be estimated from observations on easily identified groups of individuals, is typically easier to calculate, and provides an intuitive meaning for R0 when they coincide.</jats:p>", "DOI": "10.32942/x2267z", "type": "posted-content", "created": {"date-parts": [[2026, 8, 27]], "date-time": "2026-08-27T16:07:16Z", "timestamp": 1787846836000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["The Cohort Net Reproductive Rate: an empirically grounded approach to R0 for structured populations and epidemics"], "prefix": "10.32942", "author": [{"ORCID": "https://orcid.org/0000-0003-3680-5049", "authenticated-orcid": false, "given": "Christophe", "family": "Coste", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Steven", "family": "Sait", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Mike", "family": "Fowler", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Stephen", "family": "Ellner", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "29705", "link": [{"URL": "https://ecoevorxiv.org/repository/object/14648/download/25506/", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}], "deposited": {"date-parts": [[2026, 8, 27]], "date-time": "2026-08-27T16:07:16Z", "timestamp": 1787846836000}, "score": 24.581644, "resource": {"primary": {"URL": "https://ecoevorxiv.org/repository/view/14648/"}}, "issued": {"date-parts": [[2026, 8, 27]]}, "references-count": 0, "URL": "https://doi.org/10.32942/x2267z", "published": {"date-parts": [[2026, 8, 27]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2025, 11, 8]], "date-time": "2025-11-08T12:43:54Z", "timestamp": 1762605834371, "version": "build-2065373602"}, "publisher-location": "Stroudsburg, PA, USA", "reference-count": 0, "publisher": "Association for Computational Linguistics", "content-domain": {