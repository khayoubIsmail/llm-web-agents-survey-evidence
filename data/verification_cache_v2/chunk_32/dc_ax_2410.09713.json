{"data": {"id": "10.48550/arxiv.2410.09713", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2410.09713", "prefix": "10.48550", "suffix": "arxiv.2410.09713", "identifiers": [{"identifier": "2410.09713", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2410.09713"}], "creators": [{"name": "Zhang, Weinan", "nameType": "Personal", "givenName": "Weinan", "familyName": "Zhang", "affiliation": [], "nameIdentifiers": []}, {"name": "Liao, Junwei", "nameType": "Personal", "givenName": "Junwei", "familyName": "Liao", "affiliation": [], "nameIdentifiers": []}, {"name": "Li, Ning", "nameType": "Personal", "givenName": "Ning", "familyName": "Li", "affiliation": [], "nameIdentifiers": []}, {"name": "Du, Kounianhua", "nameType": "Personal", "givenName": "Kounianhua", "familyName": "Du", "affiliation": [], "nameIdentifiers": []}, {"name": "Lin, Jianghao", "nameType": "Personal", "givenName": "Jianghao", "familyName": "Lin", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Agentic Information Retrieval"}], "publisher": "arXiv", "container": {}, "publicationYear": 2024, "subjects": [{"lang": "en", "subject": "Information Retrieval (cs.IR)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "Artificial Intelligence (cs.AI)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2024-10-13T03:45:24Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2024-10-15T00:54:37Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2024-10-29T13:19:12Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2024-10-30T00:53:04Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2025-02-19T16:24:30Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2025-02-20T01:53:22Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2025-02-23T03:23:46Z", "dateType": "Submitted", "dateInformation": "v4"}, {"date": "2025-02-25T01:49:40Z", "dateType": "Updated", "dateInformation": "v4"}, {"date": "2024-10", "dateType": "Available", "dateInformation": "v1"}, {"date": "2024", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "4", "rightsList": [{"rights": "Creative Commons Attribution 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "Since the 1970s, information retrieval (IR) has long been defined as the process of acquiring relevant information items from a pre-defined corpus to satisfy user information needs. Traditional IR systems, while effective in domains like web search, are constrained by their reliance on static, pre-defined information items. To this end, this paper introduces agentic information retrieval (Agentic IR), a transformative next-generation paradigm for IR driven by large language models (LLMs) and AI agents. The central shift in agentic IR is the evolving definition of ``information'' from static, pre-defined information items to dynamic, context-dependent information states. Information state refers to a particular information context that the user is right in within a dynamic environment, encompassing not only the acquired information items but also real-time user preferences, contextual factors, and decision-making processes. In such a way, traditional information retrieval, focused on acquiring relevant information items based on user queries, can be naturally extended to achieving the target information state given the user instruction, which thereby defines the agentic information retrieval. We systematically discuss agentic IR from various aspects, i.e., task formulation, architecture, evaluation, case studies, as well as challenges and future prospects. We believe that the concept of agentic IR introduced in this paper not only broadens the scope of information retrieval research but also lays the foundation for a more adaptive, interactive, and intelligent next-generation IR paradigm.", "descriptionType": "Abstract"}, {"description": "11 pages, perspective paper", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2410.09713", "contentUrl": null, "metadataVersion": 3, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2024-10-15T04:05:29.000Z", "registered": "2024-10-15T04:05:30.000Z", "published": "2024", "updated": "2025-02-25T05:06:50.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2410.09713", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}