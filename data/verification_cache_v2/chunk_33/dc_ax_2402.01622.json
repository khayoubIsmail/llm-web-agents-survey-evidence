{"data": {"id": "10.48550/arxiv.2402.01622", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2402.01622", "prefix": "10.48550", "suffix": "arxiv.2402.01622", "identifiers": [{"identifier": "2402.01622", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2402.01622"}], "creators": [{"name": "Xie, Jian", "nameType": "Personal", "givenName": "Jian", "familyName": "Xie", "affiliation": [], "nameIdentifiers": []}, {"name": "Zhang, Kai", "nameType": "Personal", "givenName": "Kai", "familyName": "Zhang", "affiliation": [], "nameIdentifiers": []}, {"name": "Chen, Jiangjie", "nameType": "Personal", "givenName": "Jiangjie", "familyName": "Chen", "affiliation": [], "nameIdentifiers": []}, {"name": "Zhu, Tinghui", "nameType": "Personal", "givenName": "Tinghui", "familyName": "Zhu", "affiliation": [], "nameIdentifiers": []}, {"name": "Lou, Renze", "nameType": "Personal", "givenName": "Renze", "familyName": "Lou", "affiliation": [], "nameIdentifiers": []}, {"name": "Tian, Yuandong", "nameType": "Personal", "givenName": "Yuandong", "familyName": "Tian", "affiliation": [], "nameIdentifiers": []}, {"name": "Xiao, Yanghua", "nameType": "Personal", "givenName": "Yanghua", "familyName": "Xiao", "affiliation": [], "nameIdentifiers": []}, {"name": "Su, Yu", "nameType": "Personal", "givenName": "Yu", "familyName": "Su", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "TravelPlanner: A Benchmark for Real-World Planning with Language Agents"}], "publisher": "arXiv", "container": {}, "publicationYear": 2024, "subjects": [{"lang": "en", "subject": "Computation and Language (cs.CL)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2024-02-02T18:39:51Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2024-02-05T01:34:29Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2024-02-05T06:48:01Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2024-02-06T01:40:36Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2024-06-23T08:50:17Z", "dateType": "Submitted", "dateInformation": "v3"}, {"date": "2024-06-25T00:41:45Z", "dateType": "Updated", "dateInformation": "v3"}, {"date": "2024-10-23T15:02:57Z", "dateType": "Submitted", "dateInformation": "v4"}, {"date": "2024-10-24T00:56:13Z", "dateType": "Updated", "dateInformation": "v4"}, {"date": "2024-02", "dateType": "Available", "dateInformation": "v1"}, {"date": "2024", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "4", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Planning has been part of the core pursuit for artificial intelligence since its conception, but earlier AI agents mostly focused on constrained settings because many of the cognitive substrates necessary for human-level planning have been lacking. Recently, language agents powered by large language models (LLMs) have shown interesting capabilities such as tool use and reasoning. Are these language agents capable of planning in more complex settings that are out of the reach of prior AI agents? To advance this investigation, we propose TravelPlanner, a new planning benchmark that focuses on travel planning, a common real-world planning scenario. It provides a rich sandbox environment, various tools for accessing nearly four million data records, and 1,225 meticulously curated planning intents and reference plans. Comprehensive evaluations show that the current language agents are not yet capable of handling such complex planning tasks-even GPT-4 only achieves a success rate of 0.6%. Language agents struggle to stay on task, use the right tools to collect information, or keep track of multiple constraints. However, we note that the mere possibility for language agents to tackle such a complex problem is in itself non-trivial progress. TravelPlanner provides a challenging yet meaningful testbed for future language agents.", "descriptionType": "Abstract"}, {"description": "ICML 2024 (Spotlight)", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2402.01622", "contentUrl": null, "metadataVersion": 3, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2024-02-05T02:25:25.000Z", "registered": "2024-02-05T02:25:26.000Z", "published": "2024", "updated": "2024-10-24T02:24:11.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2402.01622", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}