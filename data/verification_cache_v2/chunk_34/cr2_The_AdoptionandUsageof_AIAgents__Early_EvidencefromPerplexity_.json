rossref", "is-referenced-by-count": 0, "title": ["Early to Bed, Early to Rise: Do Early Class Times Mean Early Bedtimes?"], "prefix": "10.1037", "author": [{"given": "Erin", "family": "Hiveley", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Kethera", "family": "Fogler", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Jeff", "family": "Dyche", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "15", "container-title": ["PsycEXTRA Dataset"], "deposited": {"date-parts": [[2024, 2, 13]], "date-time": "2024-02-13T17:27:39Z", "timestamp": 1707845259000}, "score": 8.658207, "resource": {"primary": {"URL": "https://doi.apa.org/doi/10.1037/e626972012-094"}}, "subtitle": ["(626972012-094)"], "issued": {"date-parts": [[2008]]}, "references-count": 0, "alternative-id": ["626972012-094"], "URL": "https://doi.org/10.1037/e626972012-094", "published": {"date-parts": [[2008]]}}, {"indexed": {"date-parts": [[2024, 5, 12]], "date-time": "2024-05-12T04:28:14Z", "timestamp": 1715488094530}, "reference-count": 0, "publisher": "Oxford University Press", "isbn-type": [{"value": "9780198758679", "type": "print"}, {"value": "9780191818592", "type": "electronic"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2020, 9, 17]]}, "abstract": "<p>\u201cEthics in Early Greek Medicine\u201d consists of two parts. The first examines analyses of emotions, character, and ethical conduct in the Hippocratic treatises; precisely in chapter 9 of <italic>Humors</italic> and its echoes in the <italic>Epidemics</italic>; and various theories of the physiology of ethical emotions developed in the <italic>Sacred Disease</italic>, <italic>Airs Waters Places</italic>, and <italic>On Regimen</italic>. The second part examines the ethics prescribed for the physician, his entourage, and patients; precisely the ethical function of the myth of Asclepius (particularly in terms of the question of the pursuit of profit and the limitations of medicine in the face of incurable diseases), the ethics of assisting nature (in view of the problem of violent therapies), and the duties of the physician and patient (in view of the\u2014admittedly difficult to date\u2014Hippocratic <italic>Oath</italic>).</p>", "DOI": "10.1093/oso/9780198758679.003.0023", "type": "book-chapter", "created": {"date-parts": [[2020, 10, 22]], "date-time": "2020-10-22T03:59:06Z", "timestamp": 1603339146000}, "page": "520-544", "source": "Crossref", "is-referenced-by-count": 1, "title": ["Ethics in Early Greek Medicine"], "prefix": "10.1093", "author": [{"given": "Paul", "family": "Demont", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "286", "published-online": {"date-parts": [[2020, 10, 22]]}, "container-title": ["Early Greek Ethics"], "original-title": ["Ethics in Early Greek Medicine"], "language": "en", "deposited": {"date-parts": [[2022, 8, 2]], "date-time": "2022-08-02T18:10:42Z", "timestamp": 1659463842000}, "score": 8.655401, "resource": {"primary": {"URL": "https://academic.oup.com/book/33502/chapter/287817940"}}, "issued": {"date-parts": [[2020, 9, 17]]}, "ISBN": ["9780198758679", "9780191818592"], "references-count": 0, "URL": "https://doi.org/10.1093/oso/9780198758679.003.0023", "published": {"date-parts": [[2020, 9, 17]]}}, {"indexed": {"date-parts": [[2024, 9, 11]], "date-time": "2024-09-11T00:48:22Z", "timestamp": 1726015702623}, "reference-count": 0, "publisher": "Policy Research Working Paper", "isbn-type": [{"type": "electronic", "value": "9781474209694"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2014]]}, "DOI": "10.5040/9781474209694.0002", "type": "other", "created": {"date-parts": [[2019, 3, 27]], "date-time": "2019-03-27T16:17:51