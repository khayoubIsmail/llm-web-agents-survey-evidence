]]}}, "alternative-id": ["10.1080/01944363.2022.2052157"], "URL": "https://doi.org/10.1080/01944363.2022.2052157", "ISSN": ["0194-4363", "1939-0130"], "issn-type": [{"value": "0194-4363", "type": "print"}, {"value": "1939-0130", "type": "electronic"}], "published": {"date-parts": [[2022, 6, 30]]}, "assertion": [{"value": "The publishing and review policy for this title is described in its Aims & Scope.", "order": 1, "name": "peerreview_statement", "label": "Peer Review Statement"}, {"value": "http://www.tandfonline.com/action/journalInformation?show=aimsScope&journalCode=rjpa20", "URL": "http://www.tandfonline.com/action/journalInformation?show=aimsScope&journalCode=rjpa20", "order": 2, "name": "aims_and_scope_url", "label": "Aim & Scope"}, {"value": "2022-06-30", "order": 3, "name": "published", "label": "Published", "group": {"name": "publication_history", "label": "Publication History"}}]}, {"institution": [{"name": "McGraw-Hill Education", "acronym": ["MHE"]}], "indexed": {"date-parts": [[2024, 1, 12]], "date-time": "2024-01-12T02:28:05Z", "timestamp": 1705026485546}, "reference-count": 0, "publisher": "McGraw-Hill Professional", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.1036/1097-8542.yb084290", "type": "dataset", "created": {"date-parts": [[2015, 7, 10]], "date-time": "2015-07-10T19:02:00Z", "timestamp": 1436554920000}, "source": "Crossref", "is-referenced-by-count": 1, "title": ["Capabilities-based planning"], "prefix": "10.1036", "member": "7599", "container-title": ["AccessScience"], "deposited": {"date-parts": [[2023, 4, 25]], "date-time": "2023-04-25T18:25:19Z", "timestamp": 1682447119000}, "score": 29.904778, "resource": {"primary": {"URL": "https://www.accessscience.com/content/article/aYB084290"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.1036/1097-8542.yb084290"}, {"indexed": {"date-parts": [[2025, 12, 19]], "date-time": "2025-12-19T15:43:53Z", "timestamp": 1766159033987}, "reference-count": 0, "publisher": "Association for the Advancement of Artificial Intelligence (AAAI)", "content-domain": {"domain": [], "crossmark-restriction": false}, "short-container-title": ["ICAPS"], "abstract": "<jats:p>\n      \n        Applications that require alternative plans challenge the single solution, single quality metric assumptions upon which many classical planners are designed and evaluated. To evaluate the distinctness of alternative plans (i.e., plan sets), researchers have created diversity metrics that often measure the set difference between the actions of plans. Many approaches for generating plan sets embed the same diversity metric in a weighted evaluation function to guide the search mechanism, thus confounding the search process with its evaluation. We discover that two diversity metrics fail to distinguish similar plans from each other or to identify plans with extraneous actions, so we introduce two new diversity metrics, \\emph{uniqueness} and \\emph{overlap}, to capture these cases. We then examine the tradeoffs of producing diverse plans while we control for plan length and metric interaction and confirm that metric interaction can significantly impact search performance.  We show that planners searching for plan sets must consider a third metric, \\emph{parsimony}, that prefers shorter plans while maximizing diversity.We evaluate three existing approaches for generating diverse plans and two new algorithms that are designed to explicitly manage diversity and interaction between the diversity and quality metrics. Our findings synthesize and extend recent results in plan diversity.\n      \n    </jats:p>", "DOI": "10.1609/icaps.v24i1.13649", "type": "journal-article", "created": {"date-parts": [[2022, 9, 27]], "date-time": "2022-09-27T19:27:39Z", "timestamp": 1664306859000}, "page": "253-261", "source": "Crossref", "is-referenced-by-count": 3, "title": ["Evaluating Diversity in Classical Planning"], "prefix": "10.1609", "volume": "24", "author": [{"given": "Mark", "family": "Roberts", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Adele", "family": "Howe", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Indrajit", "family": "Ray", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "9382", "published-online": {"date-parts": [[2014, 5, 11]]}, "container-title": ["Proceedings of the International Conference on Automated Planning and Scheduling"], "link": [{"URL": "https://ojs.aaai.org/index.php/ICAPS/article/download/13649/13498", "content-type": "application/pdf", "content-version": "vor", "intended-application": "text-mining"}, {"URL": "https://ojs.aaai.org/index.php/ICAPS/article/download/13649/13498", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2022, 9, 27]], "date-time": "2022-09-27T19:27:40Z", "timestamp": 1664306860000}, "score": 29.78405, "resource": {"primary": {"URL": "https://ojs.aaai.org/index.php/ICAPS/article/view/13649"}}, "issued": {"date-parts": [[2014, 5, 11]]}, "references-count": 0, "URL": "https://doi.org/10.1609/icaps.v24i1.13649", "ISSN": ["2334-0843", "2334-0835"], "issn-type": [{"value": "2334-0843", "type": "electronic"}, {"value": "2334-0835", "type": "print"}], "published": {"date-parts": [[2014, 5, 11]]}}, {"indexed": {"date-parts": [[2026, 8, 29]], "date-time": "2026-08-29T03:59:50Z", "timestamp": 1787975990169, "version": "build-2784847793"}, "reference-count": 1, "publisher": "Informa UK Limited", "issue": "6-8", "content-domain": {"domain": ["www.tandfonline.com"], "crossmark-restriction": true}, "short-container-title": ["Production Planning &amp; Control"], "published-print": {"date-parts": [[2017, 6, 11]]}, "DOI": "10.1080/09537287.2017.1309680", "type": "journal-article", "created":