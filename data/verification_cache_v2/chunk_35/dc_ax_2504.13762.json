{"data": {"id": "10.48550/arxiv.2504.13762", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2504.13762", "prefix": "10.48550", "suffix": "arxiv.2504.13762", "identifiers": [{"identifier": "2504.13762", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2504.13762"}], "creators": [{"name": "Benzine, Wissal", "nameType": "Personal", "givenName": "Wissal", "familyName": "Benzine", "affiliation": [], "nameIdentifiers": []}, {"name": "Bemani, Ali", "nameType": "Personal", "givenName": "Ali", "familyName": "Bemani", "affiliation": [], "nameIdentifiers": []}, {"name": "Ksairi, Nassar", "nameType": "Personal", "givenName": "Nassar", "familyName": "Ksairi", "affiliation": [], "nameIdentifiers": []}, {"name": "Slock, Dirk", "nameType": "Personal", "givenName": "Dirk", "familyName": "Slock", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Models, Methods and Waveforms for Estimation and Prediction of Doubly Sparse Time-Varying Channels"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Information Theory (cs.IT)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-04-18T15:59:58Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-04-21T00:45:20Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-11-07T10:37:11Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2025-11-10T01:33:27Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2025-04", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "This paper investigates channel estimation for linear time-varying (LTV) wireless channels under double sparsity, i.e., sparsity in both the delay and Doppler domains. An on-grid approximation is first considered, enabling rigorous hierarchical-sparsity modeling and compressed sensing-based channel estimation. Guaranteed recovery conditions are provided for affine frequency division multiplexing (AFDM), orthogonal frequency division multiplexing (OFDM) and single-carrier modulation (SCM), highlighting the superiority of AFDM in terms of doubly sparse channel estimation. To address arbitrary Doppler shifts, a relaxed version of the on-grid model is introduced by making use of multiple elementary Expansion Models (BEM) each based on Discrete Prolate Spheroidal Sequences (DPSS). Next, theoretical guarantees are provided for the precision of this off-grid model before further extending it to tackle channel prediction by exploiting the inherent DPSS extrapolation capability. Finally, numerical results are provided to both validate the proposed off-grid model for channel estimation and prediction purposes under the double sparsity assumption and to compare the corresponding mean squared error (MSE) and the overhead performance when the different wireless waveforms are used.", "descriptionType": "Abstract"}, {"description": "Revised version after reviewers comments for IEEE Transactions on Wireless Communications", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2504.13762", "contentUrl": null, "metadataVersion": 1,