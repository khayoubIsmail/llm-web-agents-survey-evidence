{"data": {"id": "10.48550/arxiv.2504.18289", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2504.18289", "prefix": "10.48550", "suffix": "arxiv.2504.18289", "identifiers": [{"identifier": "2504.18289", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2504.18289"}], "creators": [{"name": "Beltr\u00e1n, Antonio", "nameType": "Personal", "givenName": "Antonio", "familyName": "Beltr\u00e1n", "affiliation": [], "nameIdentifiers": []}, {"name": "Shao, Changguo", "nameType": "Personal", "givenName": "Changguo", "familyName": "Shao", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Supersolvable subgroups of order divisible by 3"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Group Theory (math.GR)", "subjectScheme": "arXiv"}, {"subject": "FOS: Mathematics", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Mathematics", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"lang": "en", "subject": "20D05, 20E28", "subjectScheme": "MSC"}], "contributors": [], "dates": [{"date": "2025-04-25T12:01:12Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-04-28T00:41:58Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-04-28T08:12:53Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2025-04-29T01:25:06Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2025-04", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rights": "Creative Commons Attribution 4.0 International", "rightsUri": "https://creativecommons.org/licenses/by/4.0/legalcode", "schemeUri": "https://spdx.org/licenses/", "rightsIdentifier": "cc-by-4.0", "rightsIdentifierScheme": "SPDX"}], "descriptions": [{"description": "We determine the structure of the finite non-solvable groups of order divisible by $3$ all whose maximal subgroups of order divisible by $3$ are supersolvable. Precisely, we demonstrate that if $G$ is a finite non-solvable group satisfying the above condition on maximal subgroups, then either $G$ is a $3'$-group or $G/{\\bf O}_{3'}(G)$ is isomorphic to ${\\rm PSL}_2(2^p)$ for an odd prime $p$, where ${\\bf O}_{3'}(G)$ denotes the largest normal $3'$-subgroup of $G$. Furthermore, in the latter case, ${\\bf O}_{3'}(G)$ is nilpotent and ${\\bf O}_2(G)\\leq {\\bf Z}(G)$.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2504.18289", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-04-28T01:48:13.000Z", "registered": "2025-04-28T01:48:14.000Z", "published": "2025", "updated": "2025-04-29T04:04:18.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.48550/arxiv.2504.18289", "type": "media"}}, "references": {"data": []}, "citations": {"data": []}, "parts": {"data": []}, "partOf": {"data": []}, "versions": {"data": []}, "versionOf": {"data": []}}}}