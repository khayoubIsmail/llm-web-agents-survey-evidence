{"data": {"id": "10.48550/arxiv.2501.16500", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2501.16500", "prefix": "10.48550", "suffix": "arxiv.2501.16500", "identifiers": [{"identifier": "2501.16500", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2501.16500"}], "creators": [{"name": "Pistillo, Matteo", "nameType": "Personal", "givenName": "Matteo", "familyName": "Pistillo", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Towards Frontier Safety Policies Plus"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Computers and Society (cs.CY)", "subjectScheme": "arXiv"}, {"subject": "FOS: Computer and information sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Computer and information sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-01-27T21:02:38Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-01-29T01:08:17Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-01", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "1", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "This paper examines the state of affairs on Frontier Safety Policies in light of capability progress and growing expectations held by government actors and AI safety researchers from these safety policies. It subsequently argues that FSPs should evolve to a more granular version, which this paper calls FSPs Plus. Compared to the first wave of FSPs led by a subset of frontier AI companies, FSPs Plus should be built around two main pillars. First, FSPs Plus should adopt precursory capabilities as a new, clearer, and more comprehensive set of metrics. In this respect, this paper recommends that international or domestic standardization bodies develop a standardized taxonomy of precursory components to high-impact capabilities that FSPs Plus could then adopt by reference. The Frontier Model Forum could lead the way by establishing preliminary consensus amongst frontier AI developers on this topic. Second, FSPs Plus should expressly incorporate AI safety cases and establish a mutual feedback mechanism between FSPs Plus and AI safety cases. To establish such a mutual feedback mechanism, FSPs Plus could be updated to include a clear commitment to make AI safety cases at different milestones during development and deployment, to build and adopt safety measures based on the content and confidence of AI safety cases, and, also on this basis, to keep updating and adjusting FSPs Plus.", "descriptionType": "Abstract"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2501.16500", "contentUrl": null, "metadataVersion": 0, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-01-29T02:37:12.000Z", "registered": "2025-01-29T02:37:13.000Z", "published": "2025", "updated": "2025-01-29T02:37:13.000Z"}, "relationships": {"client": {"data": {"id": "arxiv.content", "type": "clients"}}, "provider": {"data": {"id": "arxiv", "type": "providers"}}, "media": {"data": {"id": "10.