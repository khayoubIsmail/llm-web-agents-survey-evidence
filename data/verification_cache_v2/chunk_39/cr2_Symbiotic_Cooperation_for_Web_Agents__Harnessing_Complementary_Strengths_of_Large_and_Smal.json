26]]}}, "URL": "https://doi.org/10.32604/cmc.2025.073979", "ISSN": ["1546-2226"], "issn-type": [{"value": "1546-2226", "type": "electronic"}], "published": {"date-parts": [[2026]]}}, {"indexed": {"date-parts": [[2026, 9, 8]], "date-time": "2026-09-08T16:11:07Z", "timestamp": 1788883867550, "version": "build-2803163510"}, "publisher-location": "New York", "edition-number": "1", "reference-count": 0, "publisher": "Chapman and Hall/CRC", "isbn-type": [{"value": "9781003650065", "type": "electronic"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2026, 9, 8]]}, "DOI": "10.1201/9781003650065-12", "type": "book-chapter", "created": {"date-parts": [[2026, 9, 8]], "date-time": "2026-09-08T15:52:42Z", "timestamp": 1788882762000}, "page": "285-301", "source": "Crossref", "is-referenced-by-count": 0, "title": ["LLMs-Powered Agents"], "prefix": "10.1201", "author": [{"given": "P. R.", "family": "Joe Dhanith", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "S.", "family": "Geetha", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "A.", "family": "Sheik Abdullah", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "301", "container-title": ["An Introduction to Large Language Models"], "language": "en", "deposited": {"date-parts": [[2026, 9, 8]], "date-time": "2026-09-08T15:52:44Z", "timestamp": 1788882764000}, "score": 24.076237, "resource": {"primary": {"URL": "https://www.taylorfrancis.com/books/9781003650065/chapters/10.1201/9781003650065-12"}}, "issued": {"date-parts": [[2026, 9, 8]]}, "ISBN": ["9781003650065"], "references-count": 0, "URL": "https://doi.org/10.1201/9781003650065-12", "published": {"date-parts": [[2026, 9, 8]]}}, {"institution": [{"id": [{"id": "https://ror.org/0040r6f76", "id-type": "ROR", "asserted-by": "publisher"}, {"id": "https://www.isni.org/0000000122923111", "id-type": "ISNI", "asserted-by": "publisher"}, {"id": "https://www.wikidata.org/entity/Q1150437", "id-type": "wikidata", "asserted-by": "publisher"}], "name": "Te Herenga Waka\u2014Victoria University of Wellington", "department": ["New Zealand School of Music"]}], "indexed": {"date-parts": [[2026, 7, 30]], "date-time": "2026-07-30T16:14:51Z", "timestamp": 1785428091302, "version": "3.56.0"}, "reference-count": 0, "publisher": "Victoria University of Wellington Library", "license": [{"content-version": "unspecified", "delay-in-days": 0, "URL": "https://www.wgtn.ac.nz/library/about-us/policies-and-strategies/copyright-for-the-researcharchive"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>This constructivist case study research investigated how a specific\ncounselling model, Strength-Based Counselling (SBC), can be adopted\nwhen working with families in music therapy with their children, aged zero\nto five years old at a multidisciplinary, early intervention service. Set within\ninterpretivist constructivism, the research drew on two case studies of\nfamilies and their children to uncover the musical and personal strengths\nexhibited in music therapy sessions. Data sources included observations\nand clinical notes from sessions, records and meeting notes from the\nservice, and literature. Thematic analysis, including inductive and\ndeductive reasoning, were utilised to identify and reflect what strengths\nemerged from working with families and their child, and how I as the\nresearcher and music therapist employed SBC methods into my emerging\npractice. The findings affirmed what was found in the abundance of\nliterature and research on working with children and families in early\nintervention settings. However, the findings further illuminated how music\ntherapists can improve their practice. This was through implementing\naspects of SBC to flexibly respond to the individual and collective needs\nand achievements of families and children, by maintaining reciprocal\nrelationships with one another.</jats:p>", "DOI": "10.26686/2gg6-kdb4", "type": "dissertation", "created": {"date-parts": [[2026, 6, 13]], "date-time": "2026-06-13T23:17:47Z", "timestamp": 1781392667000}, "approved": {"date-parts": [[2026, 6, 13]]}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Soundscapes of Strengths: Harnessing the Strengths of Families in Music Therapy with Children in Early Intervention"], "prefix": "10.26686", "author": [{"given": "Zoe", "family": "Ioannou", "sequence": "first", "affiliation": [{"id": [{"id": "https://ror.org/0040r6f76", "id-type": "ROR", "asserted-by": "publisher"}, {"id": "https://www.isni.org/0000000122923111", "id-type": "ISNI", "asserted-by": "publisher"}]}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "11224", "contributor": [{"sequence": "additional", "affiliation": [], "role": [null]}], "deposited": {"date-parts": [[2026, 6, 13]], "date-time": "2026-06-13T23:17:51Z", "timestamp": 1781392671000}, "score": 24.03563, "degree": ["Master of Music Therapy"], "resource": {"primary": {"URL": "https://openaccess.wgtn.ac.nz/articles/thesis/_/32667159"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.26686/2gg6-kdb4"}], "items-per-page": 10, "query": {"start-index": 0, "search-terms": null}}}