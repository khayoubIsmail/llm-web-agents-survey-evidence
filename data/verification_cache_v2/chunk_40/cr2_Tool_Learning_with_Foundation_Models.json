abulary": "crossref"}]}], "member": "5801", "deposited": {"date-parts": [[2025, 8, 25]], "date-time": "2025-08-25T07:42:05Z", "timestamp": 1756107725000}, "score": 21.515648, "degree": ["Ph.D."], "resource": {"primary": {"URL": "https://hdl.handle.net/1783.1/151256"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.14711/thesis-hdl151256"}, {"institution": [{"name": "The Hong Kong University of Science and Technology", "acronym": ["HKUST"], "place": ["Clear Water Bay, Kowloon, Hong Kong"]}], "indexed": {"date-parts": [[2026, 3, 13]], "date-time": "2026-03-13T06:02:23Z", "timestamp": 1773381743199, "version": "3.50.1"}, "reference-count": 0, "publisher": "The Hong Kong University of Science and Technology Library", "content-domain": {"domain": [], "crossmark-restriction": false}, "DOI": "10.14711/thesis-hdl169590", "type": "dissertation", "created": {"date-parts": [[2026, 3, 12]], "date-time": "2026-03-12T23:02:32Z", "timestamp": 1773356552000}, "approved": {"date-parts": [[2026]]}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["On the Development and Evaluation of Asynchronous Reinforcement Learning for Foundation Models"], "prefix": "10.14711", "author": [{"given": "Jiashu", "family": "Wang", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "5801", "deposited": {"date-parts": [[2026, 3, 12]], "date-time": "2026-03-12T23:02:32Z", "timestamp": 1773356552000}, "score": 21.206713, "degree": ["M.Phil."], "resource": {"primary": {"URL": "https://hdl.handle.net/1783.1/169590"}}, "issued": {"date-parts": [[null]]}, "references-count": 0, "URL": "https://doi.org/10.14711/thesis-hdl169590"}, {"indexed": {"date-parts": [[2026, 7, 30]], "date-time": "2026-07-30T22:01:20Z", "timestamp": 1785448880794, "version": "3.56.0"}, "posted": {"date-parts": [[2025, 3, 13]]}, "group-title": "Computational Science Seminars", "reference-count": 20, "publisher": "Cassyni", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Neural network driven applications like ChatGPT suffer from hallucinations where they confidently provide inaccurate information. A funda- mental reason for this inaccuracy is the feed-forward nature of inductive decisions taken by neural networks. Such decisions are a result of training schemes that do not allow networks to deviate from and creatively abduce reasons at inference. With the advent of foundation models that are adapted across applications and data, humans can directly intervene and prompt vision-language foundation models. However, without understanding the operational limits of the underlying networks, human interventions often lead to unfair, inaccurate, hallucinated and unintelligible outputs. These outputs undermine the trust in foundation models, thereby causing roadblocks to their adoption in everyday lives. In this talk, we review systematic ways to analyze and understand human interventions in neural network functionality at inference. Specifically, we show that a human-AI collaborative environment via inferential machine learning techniques is a promising endeavor. We coined the term inferential machine learning in 2022 to reflect the opportunities and challenges in this space.</jats:p>", "DOI": "10.52843/cassyni.z4r8dt", "type": "posted-content", "created": {"date-parts": [[2025, 3, 18]], "date-time": "2025-03-18T06:23:26Z", "timestamp": 1742279006000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Inferential Machine Learning: Towards Human-collaborative Foundation Models"], "prefix": "10.52843", "author": [{"ORCID": "https://orcid.org/0000-0001-6818-8001", "authenticated-orcid": false, "given": "Ghassan", "family": "AlRegib", "sequence": "first", "affiliation": [{"id": [{"id": "https://ror.org/01zkghx44", "id-type": "ROR", "asserted-by": "publisher"}], "name": "Georgia Institute of Technology"}], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "30676", "reference": [{"key": "ref0", "unstructured": "https://arxiv.org/pdf/2202.11838.pdf"}, {"key": "ref1", "unstructured": "2406.05149: (https://arxiv.org/abs/2406.05149)"}, {"key": "ref2", "unstructured": "2406.00573: (https://arxiv.org/abs/2406.00573)"}, {"key": "ref3", "unstructured": "2410.23200: (https://arxiv.org/abs/2410.23200)"}, {"key": "ref4", "unstructured": "2410.22048: (https://arxiv.org/abs/2410.22048)"}, {"key": "ref5", "unstructured": "https://arxiv.org/pdf/2406.00573"}, {"key": "ref6", "unstructured": "https://arxiv.org/pdf/2304.02834.pdf"}, {"key": "ref7", "unstructured": "https://arxiv.org/pdf/1810.06631"}, {"key": "ref8", "unstructured": "https://arxiv.org/pdf/2410.23200"}, {"key": "ref9", "unstructured": "https://arxiv.org/abs/2410.22048"}, {"key": "ref10", "unstructured": "https://arxiv.org/pdf/2411.10896"}, {"key": "ref11", "unstructured": "https://arxiv.org/pdf/2406.06848"}, {"key": "ref12", "unstructured": "https://arxiv.org/pdf/2405.17494"}, {"key": "ref13", "unstructured": "https://arxiv.org/pdf/2209.08425.pdf"}, {"key": "ref14", "unstructured": "https://arxiv.org/abs/2301.05106"}, {"key": "ref15", "unstructured": "https://arxiv.org/pdf/2007.09507.pdf"}, {"key": "ref16", "unstructured": "https://arxiv.org/pdf/1908.09998.pdf"}, {"key": "ref17", "unstructured": "https://arxiv.org/pdf/1810.08293"}, {"key": "ref18", "unstructured": "https://arxiv.org/pdf/1712.02463.pdf"}, {"key": "ref19", "unstructured": "https://alregib.ece.gatech.edu/software-and-datasets/darai-daily-activity-recordings-for-artificial-intelligence-and-machine-learning/"}], "deposited": {"date-parts": [[2026, 7, 30]], "date-time": "2026-07-30T21:24:53Z", "timestamp": 1785446693000}, "score": 21.204315, "resource": {"primary": {"URL": "https://cassyni.com/events/Sn2yzuRyVG4SEUw8gn3wiV"}}, "issued": {"date-parts": [[2025, 3, 13]]}, "references-count": 20, "URL": "https://doi.org/10.52843/cassyni.z4r8dt", "published": {"date-parts": [[2025, 3, 13]]}, "sub