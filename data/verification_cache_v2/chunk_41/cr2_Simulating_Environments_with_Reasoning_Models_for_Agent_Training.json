ate-parts": [[2020]]}, "DOI": "10.4135/9781506355580.n6", "type": "book-chapter", "created": {"date-parts": [[2020, 12, 19]], "date-time": "2020-12-19T05:17:22Z", "timestamp": 1608355042000}, "page": "24-37", "source": "Crossref", "is-referenced-by-count": 0, "title": ["Agents, Environments, And Timescales"], "prefix": "10.4135", "member": "179", "container-title": ["Agent-Based Models"], "deposited": {"date-parts": [[2020, 12, 19]], "date-time": "2020-12-19T05:17:23Z", "timestamp": 1608355043000}, "score": 24.980068, "resource": {"primary": {"URL": "https://methods.sagepub.com/book/agent-based-models-2e/i395.xml"}}, "issued": {"date-parts": [[2020]]}, "references-count": 0, "alternative-id": ["10.4135/9781506355580"], "URL": "https://doi.org/10.4135/9781506355580.n6", "published": {"date-parts": [[2020]]}}, {"indexed": {"date-parts": [[2024, 9, 11]], "date-time": "2024-09-11T03:25:38Z", "timestamp": 1726025138407}, "edition-number": "0", "reference-count": 1, "publisher": "CRC Press", "isbn-type": [{"type": "electronic", "value": "9780429075605"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2010, 12, 8]]}, "DOI": "10.1201/b10407-14", "type": "book-chapter", "created": {"date-parts": [[2011, 4, 19]], "date-time": "2011-04-19T21:13:46Z", "timestamp": 1303247626000}, "page": "198-217", "source": "Crossref", "is-referenced-by-count": 0, "title": ["\u25aa Simulating Cancer Growth with Agent-Based Models S. DEISBOECK"], "prefix": "10.1201", "member": "301", "reference": [{"key": "ref9", "doi-asserted-by": "crossref", "unstructured": "Abbott, R.G., S. Forrest, and K.J. Pienta. 2006. Simulating the hallmarks of cancer. Artif. Life 12: 617\u201334.", "DOI": "10.1162/artl.2006.12.4.617"}], "container-title": ["Multiscale Cancer Modeling"], "language": "en", "deposited": {"date-parts": [[2020, 12, 22]], "date-time": "2020-12-22T16:06:55Z", "timestamp": 1608653215000}, "score": 24.569683, "resource": {"primary": {"URL": "https://www.taylorfrancis.com/books/9781439814420/chapters/10.1201/b10407-14"}}, "issued": {"date-parts": [[2010, 12, 8]]}, "ISBN": ["9780429075605"], "references-count": 1, "URL": "https://doi.org/10.1201/b10407-14", "published": {"date-parts": [[2010, 12, 8]]}}, {"indexed": {"date-parts": [[2025, 11, 14]], "date-time": "2025-11-14T07:13:39Z", "timestamp": 1763104419651, "version": "3.45.0"}, "posted": {"date-parts": [[2019, 7, 19]]}, "group-title": "SocArXiv", "reference-count": 0, "publisher": "Center for Open Science", "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<p>Linkage analyses use data from panel surveys and content analyses to assess media effects under field conditions and are able to close the gap between experimental and survey-based media effects research. Results from current studies and simulations indicate, however, that these studies systematically under-estimate real media effects as they aggregate measurement errors and reduce the complexity of media content. In response to these issues, we propose a new method for linkage analysis which applies agent-based simulations to directly assess short-term media effects using empirical data as guideposts.Results from an example study modeling opinion dynamics in the run-up of a Swiss referendum show that this method outperforms traditional regression-based linkage analyses in detail and explanatory power. In spite of the time-consuming modeling and computation process, this approach is a promising tool to study individual media effects under field conditions.</p>", "DOI": "10.31235/osf.io/gp4hm", "type": "posted-content", "created": {"date-parts": [[2019, 7, 19]], "date-time": "2019-07-19T13:05:51Z", "timestamp": 1563541551000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Simulating Hidden Dynamics. Introducing Agent-Based Models as a tool for linkage analysis"], "prefix": "10.31235", "author": [{"ORCID": "https://orcid.org/0000-0001-9039-6093", "authenticated-orcid": true, "given": "Martin", "family": "Wettstein", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "15934", "deposited": {"date-parts": [[2025, 11, 14]], "date-time": "2025-11-14T07:09:11Z", "timestamp": 1763104151000}, "score": 24.480732, "resource": {"primary": {"URL": "https://osf.io/gp4hm_v1"}}, "issued": {"date-parts": [[2019, 7, 19]]}, "references-count": 0, "URL": "https://doi.org/10.31235/osf.io/gp4hm", "published": {"date-parts": [[2019, 7, 19]]}, "subtype": "preprint"}], "items-per-page": 10, "query": {"start-index": 0, "search-terms": null}}}