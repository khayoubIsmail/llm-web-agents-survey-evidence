{"data": {"id": "10.48550/arxiv.2505.08786", "type": "dois", "attributes": {"doi": "10.48550/arxiv.2505.08786", "prefix": "10.48550", "suffix": "arxiv.2505.08786", "identifiers": [{"identifier": "2505.08786", "identifierType": "arXiv"}], "alternateIdentifiers": [{"alternateIdentifierType": "arXiv", "alternateIdentifier": "2505.08786"}], "creators": [{"name": "Ghoshal, Anish", "nameType": "Personal", "givenName": "Anish", "familyName": "Ghoshal", "affiliation": [], "nameIdentifiers": []}, {"name": "Okada, Nobuchika", "nameType": "Personal", "givenName": "Nobuchika", "familyName": "Okada", "affiliation": [], "nameIdentifiers": []}, {"name": "Paul, Arnab", "nameType": "Personal", "givenName": "Arnab", "familyName": "Paul", "affiliation": [], "nameIdentifiers": []}], "titles": [{"title": "Kination-like Era Driven by the Effective Inflaton/Higgs Potential"}], "publisher": "arXiv", "container": {}, "publicationYear": 2025, "subjects": [{"lang": "en", "subject": "Cosmology and Nongalactic Astrophysics (astro-ph.CO)", "subjectScheme": "arXiv"}, {"lang": "en", "subject": "High Energy Physics - Phenomenology (hep-ph)", "subjectScheme": "arXiv"}, {"subject": "FOS: Physical sciences", "subjectScheme": "Fields of Science and Technology (FOS)"}, {"subject": "FOS: Physical sciences", "schemeUri": "http://www.oecd.org/science/inno/38235147.pdf", "subjectScheme": "Fields of Science and Technology (FOS)"}], "contributors": [], "dates": [{"date": "2025-05-13T17:59:01Z", "dateType": "Submitted", "dateInformation": "v1"}, {"date": "2025-05-14T01:01:42Z", "dateType": "Updated", "dateInformation": "v1"}, {"date": "2025-08-26T12:59:02Z", "dateType": "Submitted", "dateInformation": "v2"}, {"date": "2025-08-27T00:42:59Z", "dateType": "Updated", "dateInformation": "v2"}, {"date": "2025-05", "dateType": "Available", "dateInformation": "v1"}, {"date": "2025", "dateType": "Issued"}], "language": null, "types": {"ris": "GEN", "bibtex": "misc", "citeproc": "article", "schemaOrg": "CreativeWork", "resourceType": "Article", "resourceTypeGeneral": "Preprint"}, "relatedIdentifiers": [], "relatedItems": [], "sizes": [], "formats": [], "version": "2", "rightsList": [{"rights": "arXiv.org perpetual, non-exclusive license", "rightsUri": "http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}], "descriptions": [{"description": "Based on the minimal $U(1)_X$ extended Standard Model, we explore cosmic inflation where the $U(1)_X$ Higgs field serves as the inflaton. We demonstrate that a stiff era with an equation of state $w &gt; 1/3$ can emerge during the inflaton's oscillatory phase after inflation, driven by the Coleman-Weinberg potential of the inflaton, arising due to radiative corrections. This leads to significant modulation and enhancement of the irreducible stochastic gravitational wave (GW) background from inflation, deviating from the conventional scale-invariant spectrum. Such a distinct GW spectrum could be detectable by next-generation GW interferometer missions, such as U-DECIGO. In our framework, the GW spectrum depends on the $U(1)_X$ gauge coupling and the mass of the $U(1)_X$ gauge boson ($Z^\\prime$). As a result, future GW observations and $Z^\\prime$ boson resonance searches at high-energy collider experiments are complementary to one another.", "descriptionType": "Abstract"}, {"description": "Accepted in Physical Review D", "descriptionType": "Other"}], "geoLocations": [], "fundingReferences": [], "xml": "", "url": "https://arxiv.org/abs/2505.08786", "contentUrl": null, "metadataVersion": 1, "schemaVersion": "http://datacite.org/schema/kernel-4", "source": "mds", "isActive": true, "state": "findable", "reason": null, "viewCount": 0, "viewsOverTime": [], "downloadCount": 0, "downloadsOverTime": [], "referenceCount": 0, "citationCount": 0, "citationsOverTime": [], "partCount": 0, "partOfCount": 0, "versionCount": 0, "versionOfCount": 0, "created": "2025-05-14T01:59:18.000Z", "registered": "2025-05-14T01:59:19.000Z", "published": "2025", "updated": "