0.1111/2041-210X.70059", "asserted-by": "subject"}]}, "published": {"date-parts": [[2024, 8, 4]]}}, {"indexed": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T16:05:50Z", "timestamp": 1781280350433, "version": "3.54.1"}, "posted": {"date-parts": [[2025, 11, 4]]}, "reference-count": 0, "publisher": "Institute of Electrical and Electronics Engineers (IEEE)", "license": [{"start": {"date-parts": [[2025, 11, 4]], "date-time": "2025-11-04T00:00:00Z", "timestamp": 1762214400000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0/"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Rapid detection of active wildfires from satellite imagery is critical for emergency response and resource allocation. Traditional operational systems rely on thermal anomaly algorithms applied to sensors such as VIIRS and MODIS, which excel at global monitoring but can miss small or obscured fires under smoke and cloud cover. Recent advances in vision-language models (VLMs) offer flexible, instruction-following image understanding that could complement thermal-based detection through visual screening of RGB satellite scenes. This study evaluates three open and closed source VLMs, Gemini 2.5 Flash, LlaVA, and Llama 3.2-Vision, for binary active-fire classification using a simple yes/no prompt across three independent trials of eight randomly sampled images each from a 500image dataset. Results indicate mean accuracies of 0.98 for Gemini 2.5 Flash, 0.728 for LlaVA, and 0.966 for Llama 3.2-Vision. Gemini 2.5 Flash had significant evidence and 95% confidence to prove its feasiblity for this application. The findings demonstrate feasibility of VLM-based fire screening but highlight some small limitations including reliance on visible-spectrum imagery without thermal bands, absence of temporal context, and lack of domain adaptation to satellite radiometry. Future work should incorporate multispectral inputs, temporal reasoning, and rigorous benchmarking against operational fire products to assess practical utility of these VLMs in satellite fire detection applications.</jats:p>", "DOI": "10.36227/techrxiv.176227849.99945094/v1", "type": "posted-content", "created": {"date-parts": [[2025, 11, 4]], "date-time": "2025-11-04T17:48:26Z", "timestamp": 1762278506000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Evaluating Multimodal Vision-Language Models for Zero-Shot Satellite-Based Wildfire Detection"], "prefix": "10.36227", "author": [{"ORCID": "https://orcid.org/0009-0000-5879-5107", "authenticated-orcid": false, "given": "Siddharth", "family": "Kohli", "sequence": "first", "affiliation": [{"name": "Sonoma Academy"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "263", "link": [{"URL": "https://www.techrxiv.org/doi/pdf/10.36227/techrxiv.176227849.99945094/v1", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T15:38:07Z", "timestamp": 1781278687000}, "score": 32.246807, "resource": {"primary": {"URL": "https://www.techrxiv.org/doi/full/10.36227/techrxiv.176227849.99945094/v1"}}, "issued": {"date-parts": [[2025, 11, 4]]}, "references-count": 0, "URL": "https://doi.org/10.36227/techrxiv.176227849.99945094/v1", "relation": {"has-version": [{"id-type": "doi", "id": "10.36227/techrxiv.176227849.99945094/v2", "asserted-by": "object"}]}, "published": {"date-parts": [[2025, 11, 4]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2026, 8, 18]], "date-time": "2026-08-18T03:27:40Z", "timestamp": 1787023660929, "version": "build-2736575974"}, "publisher-location": "Stroudsburg, PA, USA", "reference-count": 0, "publisher": "Association for Computational Linguistics", "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2022]]}, "DOI": "10.18653/v1/2022.emnlp-main.587", "type": "proceedings-article", "created": {"date-parts": [[2023, 8, 4]], "date-time": "2023-08-04T16:21:02Z", "timestamp": 1691166062000}, "page": "8560-8579", "source": "Crossref", "is-referenced-by-count": 11, "title": ["Beyond prompting: Making Pre-trained Language Models Better Zero-shot Learners by Clustering Representations"], "prefix": "10.18653", "author": [{"given": "Yu", "family": "Fei", "sequence": "first", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Zhao", "family": "Meng", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Ping", "family": "Nie", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Roger", "family": "Wattenhofer", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}, {"given": "Mrinmaya", "family": "Sachan", "sequence": "additional", "affiliation": [], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "1643", "event": {"name": "Proceedings of the 2022 Conference on Empirical Methods in Natural Language Processing", "location": "Abu Dhabi, United Arab Emirates", "start": {"date-parts": [[2022, 12]]}, "end": {"date-parts": [[2022, 12]]}}, "container-title": ["Proceedings of the 2022 Conference on Empirical Methods in Natural Language Processing"], "deposited": {"date-parts": [[2026, 1, 31]], "date-time": "2026-01-31T18:36:43Z", "timestamp": 1769884603000}, "score": 32.245426, "resource": {"primary": {"URL": "https://aclanthology.org/2022.emnlp-main.587"}}, "issued": {"date-parts": [[2022]]}, "references-count": 0, "URL": "https://doi.org/10.18653/v1/2022.emnlp-main.587", "published": {"date-parts": [[2022]]}}], "items-per-page": 10, "query": {"start-index": 0, "search-terms": null}}}