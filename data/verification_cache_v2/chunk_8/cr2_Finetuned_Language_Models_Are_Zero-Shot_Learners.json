", "content-domain": {"domain": [], "crossmark-restriction": false}, "published-print": {"date-parts": [[2023]]}, "DOI": "10.18653/v1/2023.findings-emnlp.158", "type": "proceedings-article", "created": {"date-parts": [[2023, 12, 10]], "date-time": "2023-12-10T21:58:19Z", "timestamp": 1702245499000}, "page": "2414-2432", "source": "Crossref", "is-referenced-by-count": 1, "title": ["Automated Few-Shot Classification with Instruction-Finetuned Language Models"], "prefix": "10.18653", "author": [{"given": "Rami", "family": "Aly", "sequence": "first", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Xingjian", "family": "Shi", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Kaixiang", "family": "Lin", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Aston", "family": "Zhang", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}, {"given": "Andrew", "family": "Wilson", "sequence": "additional", "affiliation": [], "role": [{"role": "author", "vocabulary": "crossref"}]}], "member": "1643", "event": {"name": "Findings of the Association for Computational Linguistics: EMNLP 2023", "start": {"date-parts": [[2023, 12]]}, "location": "Singapore", "end": {"date-parts": [[2023, 12]]}}, "container-title": ["Findings of the Association for Computational Linguistics: EMNLP 2023"], "deposited": {"date-parts": [[2023, 12, 10]], "date-time": "2023-12-10T22:11:33Z", "timestamp": 1702246293000}, "score": 32.37007, "resource": {"primary": {"URL": "https://aclanthology.org/2023.findings-emnlp.158"}}, "issued": {"date-parts": [[2023]]}, "references-count": 0, "URL": "https://doi.org/10.18653/v1/2023.findings-emnlp.158", "published": {"date-parts": [[2023]]}}, {"indexed": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T16:06:11Z", "timestamp": 1781280371192, "version": "3.54.1"}, "posted": {"date-parts": [[2025, 11, 11]]}, "reference-count": 0, "publisher": "Institute of Electrical and Electronics Engineers (IEEE)", "license": [{"start": {"date-parts": [[2025, 11, 11]], "date-time": "2025-11-11T00:00:00Z", "timestamp": 1762819200000}, "content-version": "unspecified", "delay-in-days": 0, "URL": "https://creativecommons.org/licenses/by/4.0/"}], "content-domain": {"domain": [], "crossmark-restriction": false}, "abstract": "<jats:p>Rapid detection of active wildfires from satellite imagery is critical for emergency response and resource allocation. Traditional operational systems rely on thermal anomaly algorithms applied to sensors such as VIIRS and MODIS, which excel at global monitoring but can miss small or obscured fires under smoke and cloud cover. Recent advances in vision-language models (VLMs) offer flexible, instruction-following image understanding that could complement thermal-based detection through visual screening of satellite scenes. This study evaluates three leading VLMs, Gemini 2.5 Flash, LlaVA, and Llama 3.2-Vision, for binary active-fire classification. We used a simple yes/no prompt across each image of a 500 image satellite imagery dataset. Our results indicate mean accuracies of 0.98 for Gemini 2.5 Flash, 0.728 for LlaVA, and 0.966 for Llama 3.2-Vision. Gemini 2.5 Flash had significant evidence and 95% confidence to prove its feasiblity for this application. The findings demonstrate feasibility of VLM-based fire screening but highlight some small limitations including reliance on visible-spectrum imagery without thermal bands, absence of temporal context, and lack of domain adaptation to satellite radiometry. Future work should incorporate multispectral inputs, temporal reasoning, and rigorous benchmarking against operational fire products to assess practical utility of these VLMs in satellite fire detection applications.</jats:p>", "DOI": "10.36227/techrxiv.176227849.99945094/v2", "type": "posted-content", "created": {"date-parts": [[2025, 11, 11]], "date-time": "2025-11-11T17:03:15Z", "timestamp": 1762880595000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Evaluating Multimodal Vision-Language Models for Zero-Shot Satellite-Based Wildfire Detection"], "prefix": "10.36227", "author": [{"ORCID": "https://orcid.org/0009-0000-5879-5107", "authenticated-orcid": false, "given": "Siddharth", "family": "Kohli", "sequence": "first", "affiliation": [{"name": "Sonoma Academy"}], "role": [{"vocabulary": "crossref", "role": "author"}]}], "member": "263", "link": [{"URL": "https://www.techrxiv.org/doi/pdf/10.36227/techrxiv.176227849.99945094/v2", "content-type": "unspecified", "content-version": "vor", "intended-application": "similarity-checking"}], "deposited": {"date-parts": [[2026, 6, 12]], "date-time": "2026-06-12T15:39:46Z", "timestamp": 1781278786000}, "score": 32.31139, "resource": {"primary": {"URL": "https://www.techrxiv.org/doi/full/10.36227/techrxiv.176227849.99945094/v2"}}, "issued": {"date-parts": [[2025, 11, 11]]}, "references-count": 0, "URL": "https://doi.org/10.36227/techrxiv.176227849.99945094/v2", "published": {"date-parts": [[2025, 11, 11]]}, "subtype": "preprint"}, {"indexed": {"date-parts": [[2026, 5, 21]], "date-time": "2026-05-21T20:41:08Z", "timestamp": 1779396068585, "version": "3.53.1"}, "reference-count": 0, "publisher": "Wiley", "content-domain": {"domain": []}, "published-print": {"date-parts": [[2025, 2, 8]]}, "DOI": "10.1111/2041-210x.70059/v2/review1", "type": "peer-review", "created": {"date-parts": [[2025, 5, 21]], "date-time": "2025-05-21T09:05:51Z", "timestamp": 1747818351000}, "source": "Crossref", "is-referenced-by-count": 0, "title": ["Review for \"Zero\u2010shot animal behaviour classification with vision\u2010language foundation models\""], "prefix": "10.1111", "member": "311", "review": {"type": "referee-report", "running-number": "PR3V2", "revision-round": "2", "stage": "pre-publication"}, "contributor": [{"given": "Marco",